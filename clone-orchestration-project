#!/bin/bash
# clone-orchestration-project — clone this example host to git_home/<new-name>
#
# Creates a sibling multi-agent host that uses this tree's workflows
# (Grok role launchers, packs, Landlock, setup_agent, fix-perms).
#
# Usage:
#   ./clone-orchestration-project [-n|--dry-run] [-s|--source DIR] [-g|--git-home DIR] [-t|--build-type TYPE] <new-name>
#   ./clone-orchestration-project [-n|--dry-run] [-r|--repair DIR]
#
# Build type: asked on a terminal when --build-type is omitted. android-gradle
# copies that build-examples directory (except README.md) into master/. none
# (also accepted as "other") copies no build tools. The choice is recorded in
# project-facts.md.
#
# Dest root is the managing tree, branch orchestration: a clone of this
# template with project.config filled in for this machine. master/ is not that
# tree. It is a new empty branch. The script copies the app framework into it:
# run-* launchers, the visible and hidden rules, TODO and ENGINEERING_LOG,
# and the orch helpers those need. setup_agent.sh and remove_worktree.sh stay
# on the orchestration root only.
#
# Layout of dest:
#   git_home/<name>/         branch orchestration (managing tree)
#   git_home/<name>/master/  worktree on branch master
#   git_home/<name>/sandbox/ plans / research / PRs / failure logs
#
# Git clone/commit/worktree run as primary_user (sudo -u when needed).
# Root sudo is only for chown/chmod/setuid/fix-perms.
# Never git clone as root. Does not create Unix users. Does not write sudoers.
# Does not mutate the source repo's branches.
#
# ./run-grok-* from a worktree (including master/) needs orch_root= in that
# worktree's project.config. This tool seeds dest and dest/master via
# ve_seed_worktree_project_config from dest/orch/ve-resolve-orch. Use --repair
# on a dest that was cloned before that seed existed. --repair seeds
# project.config, the filter config and smudge check, and the dest-root DAC.
# It does not copy the app framework into an empty master.
#
# Source: --source DIR, else the directory holding this script. It must have
# run-grok-orchestrator, setup_agent.sh, AGENT_MANDATES.md and project.config
# sandbox_dir naming an existing dir. git_home: --git-home, else source git_home
# (--git-home must be an absolute existing directory).
#
# new-name: one path component matching [A-Za-z0-9._-]+, not . .. master
# orchestration or agent-N. Dest git_home/<name> must not already exist.
#
# Examples:
#   ./clone-orchestration-project NEWHOST
#   ./orchestration-example/clone-orchestration-project NEWHOST    # from git_home
#   /path/to/orchestration-example/clone-orchestration-project --source /path/to/orchestration-example NEWHOST
#   ./clone-orchestration-project --repair GIT_HOME/NEWHOST

set -euo pipefail

umask 007

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CWD="$(pwd)"

DRY=0
SOURCE_ARG=""
GIT_HOME_ARG=""
REPAIR_ARG=""
BUILD_TYPE_ARG=""
BUILD_TYPE=""
NAME=""

USAGE_LINE="usage: ./clone-orchestration-project [-h] [-n] [-s DIR] [-g DIR] [-t TYPE] NEW-NAME | [-n] -r DIR"
usage() {
  cat <<EOF
$USAGE_LINE

Clone this orchestration-example tree to git_home/NEW-NAME as a new multi-agent
host (orchestration branch at the dest root, master/ worktree populated with
the tools). Asks the build type unless --build-type is set.

options:
  -h, --help             show this help message and exit
  -n, --dry-run          print resolved paths and planned steps; change nothing
  -s, --source DIR       the orchestration-example to clone (default: this script's dir)
  -g, --git-home DIR     git_home to clone into (default: the source's git_home)
  -t, --build-type TYPE  android-gradle, none, or other (other means none)
  -r, --repair DIR       bring an existing clone DIR up to date instead of cloning

Details: the comment at the top of ./clone-orchestration-project.
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

warn() {
  echo "WARNING: $*" >&2
}

abs_dir() {
  local p="$1"
  [ -d "$p" ] || return 1
  (cd "$p" && pwd)
}

read_config_key() {
  local file="$1" key="$2"
  local val=""
  [ -f "$file" ] || return 1
  val=$(sed -n "s/^${key}=//p" "$file" | tr -d '\r' | head -1)
  [ -n "$val" ] || return 1
  case "$val" in
    @@*) return 1 ;;
  esac
  printf '%s\n' "$val"
}

looks_like_example() {
  local d="$1" sd
  [ -n "$d" ] && [ -d "$d" ] || return 1
  [ -f "$d/run-grok-orchestrator" ] && [ -f "$d/setup_agent.sh" ] && [ -f "$d/AGENT_MANDATES.md" ] || return 1
  sd=$(read_config_key "$d/project.config" sandbox_dir) || return 1
  [ -d "$d/$sd" ]
}

resolve_source() {
  # One source: --source DIR, else the directory holding this script.
  local cand="${SOURCE_ARG:-$SCRIPT_DIR}"
  cand=$(abs_dir "$cand") || die "source is not a directory: $cand"
  looks_like_example "$cand" || die "source is not orchestration-example (needs run-grok-orchestrator, setup_agent.sh, AGENT_MANDATES.md, project.config sandbox_dir): $cand"
  SOURCE="$cand"
}

resolve_git_home() {
  local v=""
  if [ -n "$GIT_HOME_ARG" ]; then
    v="$GIT_HOME_ARG"
  else
    v=$(read_config_key "$SOURCE/project.config" git_home) || die "git_home has no value in $SOURCE/project.config (or pass --git-home)"
  fi
  case "$v" in
    ''|@@*) die "git_home unset or still a @@ token" ;;
    /*) ;;
    ~*|\$HOME*|\$HOME/*)
      die "git_home must be an absolute path, not ~/git or \$HOME/git (got: $v)"
      ;;
    *) die "git_home must be an absolute path (got: $v)" ;;
  esac
  [ -d "$v" ] || die "git_home is not a directory: $v"
  GIT_HOME=$(abs_dir "$v")
}

validate_name() {
  local n="$1"
  [ -n "$n" ] || die "missing <new-name>"
  case "$n" in
    .|..) die "invalid new-name: $n" ;;
    master|orchestration) die "new-name cannot be '$n' (reserved branch/worktree)" ;;
  esac
  [[ "$n" =~ ^[A-Za-z0-9._-]+$ ]] || die "new-name must match [A-Za-z0-9._-]+ (got: $n)"
  if [[ "$n" =~ ^agent-[0-9]+$ ]]; then
    die "new-name cannot be '$n' (reserved for feature worktrees)"
  fi
}

load_source_config() {
  local c="$SOURCE/project.config"
  PRIMARY_USER=$(read_config_key "$c" primary_user) || die "primary_user has no value in $c"
  PLANNING_USER=$(read_config_key "$c" planning_user) || die "planning_user has no value in $c"
  CODER_USER=$(read_config_key "$c" coder_user) || die "coder_user has no value in $c"
  ORCHESTRATOR_USER=$(read_config_key "$c" orchestrator_user) || die "orchestrator_user has no value in $c"
  SANDBOX_REL=$(read_config_key "$c" sandbox_dir) || die "sandbox_dir has no value in $c"
  SPECIAL_PATHS=$(read_config_key "$c" sandbox_special_paths) || die "sandbox_special_paths has no value in $c"
  CODE_GROUP=$(read_config_key "$c" code_group) || die "code_group has no value in $c"
}

require_users() {
  local u
  for u in "$PRIMARY_USER" "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
    if ! id "$u" >/dev/null 2>&1; then
      die "required user '$u' does not exist (this tool does not create Unix users)"
    fi
  done
}

# Git clone/commit/worktree: always primary_user, never root.
as_primary() {
  if [ "$(id -un)" = "$PRIMARY_USER" ]; then
    "$@"
  else
    sudo -u "$PRIMARY_USER" -- "$@"
  fi
}

# chown/chmod/setuid/fix-perms only.
as_root() {
  if [ "$EUID" -eq 0 ]; then
    "$@"
  else
    sudo -- "$@"
  fi
}

git_primary() {
  as_primary git -c safe.directory=* "$@"
}

# Print a planned/executed step. who = primary|root|check
step() {
  local who="$1"
  shift
  echo "  [$who] $*"
}

write_as_primary() {
  local file="$1"
  if [ "$DRY" -eq 1 ]; then
    step primary "write $file"
    cat >/dev/null
    return 0
  fi
  if [ "$(id -un)" = "$PRIMARY_USER" ]; then
    cat > "$file"
  else
    sudo -u "$PRIMARY_USER" -- tee "$file" >/dev/null
  fi
}

upsert_config_key() {
  local file="$1" key="$2" val="$3"
  if [ "$DRY" -eq 1 ]; then
    step primary "set $key=$val in $file"
    return 0
  fi
  as_primary bash -c '
    set -euo pipefail
    file="$1"; key="$2"; val="$3"
    if [ ! -f "$file" ]; then
      printf "%s=%s\n" "$key" "$val" > "$file"
      exit 0
    fi
    if grep -q "^${key}=" "$file"; then
      tmp="${file}.tmp.$$"
      sed "s|^${key}=.*|${key}=${val}|" "$file" > "$tmp"
      mv "$tmp" "$file"
    else
      printf "%s=%s\n" "$key" "$val" >> "$file"
    fi
  ' bash "$file" "$key" "$val"
}

seed_dest_project_configs() {
  step primary "ve_seed_worktree_project_config $DEST $DEST  (orch_root=$DEST)"
  step primary "ve_seed_worktree_project_config $DEST/master $DEST  (orch_root=$DEST)"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  as_primary test -f "$DEST/orch/ve-resolve-orch" || die "orch/ve-resolve-orch missing in $DEST"
  as_primary test -d "$DEST/master" || die "master worktree missing: $DEST/master"
  as_primary bash -c '
    set -euo pipefail
    DEST="$1"
    # shellcheck source=/dev/null
    . "$DEST/orch/ve-resolve-orch"
    ve_seed_worktree_project_config "$DEST" "$DEST"
    ve_seed_worktree_project_config "$DEST/master" "$DEST"
  ' bash "$DEST"
}

verify_dest_orch_root() {
  step check "$DEST/orch/ve-resolve-orch $DEST  (must print $DEST)"
  step check "$DEST/orch/ve-resolve-orch $DEST/master  (must print $DEST)"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  local got
  got=$(as_primary bash "$DEST/orch/ve-resolve-orch" "$DEST") || die "orch/ve-resolve-orch failed for $DEST"
  got="${got//$'\r'/}"
  [ "$got" = "$DEST" ] || die "orch/ve-resolve-orch $DEST printed '$got' (want $DEST)"
  got=$(as_primary bash "$DEST/orch/ve-resolve-orch" "$DEST/master") || die "orch/ve-resolve-orch failed for $DEST/master"
  got="${got//$'\r'/}"
  [ "$got" = "$DEST" ] || die "orch/ve-resolve-orch $DEST/master printed '$got' (want $DEST)"
}

do_fix_perms() {
  # Use this example's fix-perms (not dest's stale copy) with explicit worktrees.
  step root "$SCRIPT_DIR/fix-perms $DEST"
  step root "$SCRIPT_DIR/fix-perms $DEST/master"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  if ! as_root "$SCRIPT_DIR/fix-perms" "$DEST"; then
    die "fix-perms failed: $SCRIPT_DIR/fix-perms $DEST"
  fi
  if ! as_root "$SCRIPT_DIR/fix-perms" "$DEST/master"; then
    die "fix-perms failed: $SCRIPT_DIR/fix-perms $DEST/master"
  fi
}

do_dest_root_dac() {
  step root "chown $PRIMARY_USER:$CODE_GROUP $DEST $DEST/master && chmod 2775 both"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  if ! as_root chown "$PRIMARY_USER:$CODE_GROUP" "$DEST" "$DEST/master"; then
    die "chown $PRIMARY_USER:$CODE_GROUP failed for dest roots"
  fi
  if ! as_root chmod 2775 "$DEST" "$DEST/master"; then
    die "chmod 2775 failed for dest roots"
  fi
}

do_landlock_exec_dac() {
  local f
  for f in "$DEST/orch/agent-landlock" "$DEST/master/orch/agent-landlock"; do
    step root "chown $PRIMARY_USER:$CODE_GROUP $f && chmod 775 (o+x for ai-planner)"
    if [ "$DRY" -eq 1 ]; then
      continue
    fi
    [ -f "$f" ] || die "landlock helper missing: $f"
    if ! as_root chown "$PRIMARY_USER:$CODE_GROUP" "$f"; then
      die "chown landlock failed: $f"
    fi
    if ! as_root chmod 775 "$f"; then
      die "chmod 775 landlock failed: $f"
    fi
  done
}

# umask 007 (set above) makes git checkout write directories and 100755 files as 770
# owned by primary:primary. ai-planner is not in that group and not in ai-code, so it
# cannot search orch/ or execute orch/agent-landlock. sudo applies other-search,
# other-read, and other-execute, then the sandbox and work-history areas from
# perm-model.tsv. fix-perms runs after this and may tighten ownership; reassert
# runs again so a later o+r-only pass cannot leave the helper at 774.
open_tree_for_planner() {
  step root "sudo: open $DEST for $PLANNING_USER (umask 007 leaves 770)"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  [ -d "$DEST/master" ] || die "master worktree missing: $DEST/master"
  [ -f "$DEST/master/orch/agent-landlock" ] || die "orch/agent-landlock missing in $DEST/master"
  if ! as_root bash -c '
    set -euo pipefail
    export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="*"
    dest="$1"
    sandbox="$2"
    script_dir="$3"
    planning="$4"
    # shellcheck source=/dev/null
    . "$script_dir/orch/perm-lib.sh"
    perm_init "$script_dir/project.config"
    # shellcheck source=/dev/null
    . "$script_dir/orch/ve-resolve-orch"
    command -v runuser >/dev/null || { echo "ERROR: runuser is missing" >&2; exit 1; }
    for wt in "$dest" "$dest/master"; do
      if [ -e "$wt/ENGINEERING_LOG.md" ]; then
        chattr -a "$(readlink -f -- "$wt/ENGINEERING_LOG.md")"
      fi
    done
    find "$dest" \( -name .git -o -name sandbox -o -name .android-shared -o -name .gradle-home -o -name .gradle \) -prune -o -type d -exec chmod o+rx {} +
    find "$dest" \( -name .git -o -name sandbox -o -name .android-shared -o -name .gradle-home -o -name .gradle \) -prune -o -type f -exec chmod o+r {} +
    if [ -d "$sandbox" ] && [ ! -L "$sandbox" ]; then
      perm_apply sandbox "$sandbox"
    fi
    for wt in "$dest" "$dest/master"; do
      if [ -d "$wt/work-history" ]; then
        perm_apply work-history "$wt/work-history"
      fi
      for f in TODO.md project-facts.md; do
        if [ -e "$wt/$f" ] || [ -L "$wt/$f" ]; then
          perm_apply planner-files "$(readlink -f -- "$wt/$f")" --top-only
        fi
      done
      ve_ensure_tracked_exec_other_x "$wt"
    done
    helper="$dest/master/orch/agent-landlock"
    if ! runuser -u "$planning" -- test -x "$helper"; then
      echo "ERROR: $planning cannot execute $helper" >&2
      stat -c "mode=%a owner=%U:%G" "$helper" >&2
      name="$dest"
      while [ -n "$name" ]; do
        stat -c "dir mode=%a owner=%U:%G %n" "$name" >&2
        [ "$name" = / ] && break
        name=$(dirname "$name")
      done
      exit 1
    fi
  ' bash "$DEST" "$DEST/$SANDBOX_REL" "$SCRIPT_DIR" "$PLANNING_USER"; then
    die "planner access setup failed for $DEST/master"
  fi
}

reassert_planner_exec() {
  step root "sudo: reassert other-execute on tracked helpers for $PLANNING_USER"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  if ! as_root bash -c '
    set -euo pipefail
    export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="*"
    dest="$1"
    script_dir="$2"
    planning="$3"
    # shellcheck source=/dev/null
    . "$script_dir/orch/ve-resolve-orch"
    command -v runuser >/dev/null || { echo "ERROR: runuser is missing" >&2; exit 1; }
    for wt in "$dest" "$dest/master"; do
      ve_ensure_tracked_exec_other_x "$wt"
    done
    helper="$dest/master/orch/agent-landlock"
    runuser -u "$planning" -- test -x "$helper"
  ' bash "$DEST" "$SCRIPT_DIR" "$PLANNING_USER"; then
    die "$PLANNING_USER cannot execute $DEST/master/orch/agent-landlock after fix-perms"
  fi
}

# Absolute dest path without cd (dest may be 770 primary:primary; we cannot enter it).
abs_existing_dir() {
  local p="$1"
  case "$p" in
    /*) ;;
    *) p="$CWD/$p" ;;
  esac
  p="${p%/}"
  [ -d "$p" ] || return 1
  printf '%s\n' "$p"
}

dest_looks_like_clone() {
  local d="$1"
  [ -f "$d/run-grok-orchestrator" ] && [ -f "$d/setup_agent.sh" ] && [ -f "$d/AGENT_MANDATES.md" ] && [ -d "$d/master" ]
}

repair_validate_dest() {
  if dest_looks_like_clone "$DEST"; then
    return 0
  fi
  if [ ! -x "$DEST" ]; then
    if [ "$DRY" -eq 1 ]; then
      step check "dest exists but is not enterable by $(id -un); execute seeds as $PRIMARY_USER"
      return 0
    fi
    if [ "$(id -un)" = "$PRIMARY_USER" ]; then
      die "cannot enter $DEST as $PRIMARY_USER"
    fi
    echo "ERROR: $DEST is not enterable by $(id -un). Trying sudo -u $PRIMARY_USER ..." >&2
    if as_primary bash -c '
      d="$1"
      [ -f "$d/run-grok-orchestrator" ] || exit 1
      [ -f "$d/setup_agent.sh" ] || exit 1
      [ -f "$d/AGENT_MANDATES.md" ] || exit 1
      [ -d "$d/master" ] || exit 1
    ' bash "$DEST"; then
      return 0
    fi
    die "sudo -u $PRIMARY_USER failed. Run as $PRIMARY_USER: ./clone-orchestration-project --repair $DEST"
  fi
  die "--repair DIR does not look like a clone with master/ worktree: $DEST"
}

run_install_merge_drivers() {
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  if [ "$(id -un)" = "$PRIMARY_USER" ]; then
    (cd "$DEST" && ./orch/install-merge-drivers.sh)
  else
    sudo -u "$PRIMARY_USER" -- bash -c 'cd "$1" && ./orch/install-merge-drivers.sh' bash "$DEST"
  fi
}

# Filter config (./orch/install-merge-drivers.sh) + re-smudge + check, in one worktree.
smudge_and_verify() {
  local wt="$1"
  step primary "(cd $wt && ./orch/verify-smudge --fix)"
  if [ "$DRY" -eq 0 ]; then
    as_primary bash -c 'cd "$1" && ./orch/verify-smudge --fix' bash "$wt" \
      || die "unsmudged files remain in $wt (see verify-smudge ERROR lines)"
  fi
}

add_safe_directory() {
  local u="$1" path="$2"
  if [ "$DRY" -eq 1 ]; then
    if [ "$(id -un)" = "$u" ]; then
      step "$u" "git config --global --add safe.directory $path"
    else
      step root "sudo -u $u git config --global --add safe.directory $path"
    fi
    return 0
  fi
  if [ "$(id -un)" = "$u" ]; then
    git config --global --add safe.directory "$path" 2>/dev/null || true
  else
    sudo -u "$u" git config --global --add safe.directory "$path" 2>/dev/null || true
  fi
}

# Directories under build-examples/ that install files, plus none.
list_build_types() {
  local d name
  [ -d "$SOURCE/build-examples" ] || return 0
  for d in "$SOURCE"/build-examples/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    if git -C "$SOURCE" ls-files -- "build-examples/$name/" | grep -qv '/README\.md$'; then
      printf '%s\n' "$name"
    fi
  done
  printf '%s\n' none
}

build_type_known() {
  local t
  [ -n "${1:-}" ] || return 1
  while IFS= read -r t; do
    [ "$t" = "$1" ] && return 0
  done < <(list_build_types)
  return 1
}

facts_build_lines() {
  if git -C "$SOURCE" ls-files -- "build-examples/$BUILD_TYPE/build_app" | grep -q .; then
    printf '%s\n' \
      "- **Build type:** ${BUILD_TYPE}" \
      '- Build: `./build_app --standard --test`. Never `--play`: it needs David at a terminal.' \
      '- Commit: `./build_app --standard --test "<message>"|@<msg_file> <paths...>` (commits exactly the named paths, builds, and tags builds). Do not push.'
  else
    printf '%s\n' \
      "- **Build type:** ${BUILD_TYPE}" \
      '- Build: none' \
      '- Commit: `git add` the files of that change, then `git commit` as David Lang <david@lang.hm>. Do not push.'
  fi
}

choose_build_type() {
  local choice="${BUILD_TYPE_ARG:-}" known=""
  known=$(list_build_types | tr '\n' ' ' | sed 's/ *$//')
  [ -n "$known" ] || die "no build types under $SOURCE/build-examples and none is missing"
  if [ "$choice" = other ]; then
    choice=none
  fi
  if [ -n "$choice" ]; then
    build_type_known "$choice" || die "unknown build type '$choice' (one of: $known; other means none)"
    BUILD_TYPE=$choice
    return 0
  fi
  if [ ! -t 0 ]; then
    die "pass --build-type ($known). other means none. stdin is not a terminal"
  fi
  echo "What kind of project is this?"
  local t
  while IFS= read -r t; do
    case "$t" in
      android-gradle) echo "  android-gradle  Android app. Installs build_app, deploy, and screenshot capture." ;;
      none) echo "  none            Not Android. Does not install those tools. (other means this)" ;;
      *) echo "  $t" ;;
    esac
  done < <(list_build_types)
  local ans
  while true; do
    read -r -p "Build type: " ans || die "no build type read"
    [ "$ans" = other ] && ans=none
    if build_type_known "$ans"; then
      BUILD_TYPE=$ans
      return 0
    fi
    echo "Choose one of: $known (other means none)" >&2
  done
}

# Tracked paths that belong on a new app branch. Not the managing tree:
# setup_agent.sh and remove_worktree.sh stay on orchestration only.
master_framework_paths() {
  local tree="${1:-$DEST}"
  git -C "$tree" ls-files -- \
    'run-grok' 'run-grok-*' 'run-cursor' 'run-cursor-*' \
    'run-antigravity' 'run-antigravity-*' \
    AGENTS.md CLAUDE.md GEMINI.md GROK.md ANTIGRAVITY.md \
    AGENT_MANDATES.md new_agent_prompt standard-plan-compliance-block.md \
    MULTI_AGENT_USER_INSTRUCTIONS.md README-multi-agent.md \
    roles.config roles docs/rules docs/facts \
    .grok .cursor .gemini \
    TODO.md ENGINEERING_LOG.md work-history project-facts.md \
    orch git-merge-drivers filter-apply-config filter-clean-config hooks \
    .gitattributes .gitignore project.config.example \
    fix-perms landlock.config landlock.config.example \
    rules.manifest update-rules.sh \
    third_party/fetch-deps third_party/agent-coordination-tickets
}

# Copy build-examples/<type>/* except README.md into the master worktree.
# The caller commits them there. The root only records the local paths.
install_build_type() {
  local into="${1:-$DEST/master}"
  if [ "$BUILD_TYPE" = none ]; then
    step primary "build type none: do not install build-examples"
    return 0
  fi
  local path rel
  local -a rels=()
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    rel="${path#build-examples/$BUILD_TYPE/}"
    [ "$rel" = README.md ] && continue
    rels+=("$rel")
    step primary "install build-examples/$BUILD_TYPE/$rel -> $into/$rel"
  done < <(git -C "$SOURCE" ls-files -- "build-examples/$BUILD_TYPE/")
  [ "${#rels[@]}" -gt 0 ] || die "build type $BUILD_TYPE has no files to install"
  [ "$DRY" -eq 1 ] && return 0
  local rel
  for rel in "${rels[@]}"; do
    as_primary mkdir -p "$(dirname "$into/$rel")"
    as_primary cp -a "$SOURCE/build-examples/$BUILD_TYPE/$rel" "$into/$rel"
  done
  as_primary bash -c '
    set -euo pipefail
    file="$1"; shift
    touch "$file"
    for rel in "$@"; do
      line="local $rel"
      grep -qxF "$line" "$file" && continue
      if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then
        printf "\n" >> "$file"
      fi
      printf "%s\n" "$line" >> "$file"
    done
  ' bash "$DEST/rules.manifest.local" "${rels[@]}"
  git_primary -C "$DEST" add -- rules.manifest.local
  if ! git_primary -C "$DEST" diff --cached --quiet; then
    git_primary -C "$DEST" commit -m "Record $BUILD_TYPE build tools as project-local"
  fi
}

