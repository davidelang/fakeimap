#!/bin/bash
# clone-orchestration-project — clone this example host to git_home/<new-name>
#
# Creates a sibling multi-agent host that uses this tree's workflows
# (Grok role launchers, packs, Landlock, setup_agent, fix-perms).
#
# Usage:
#   ./clone-orchestration-project [-n|--dry-run] [-s|--source DIR] [-g|--git-home DIR] <new-name>
#   ./clone-orchestration-project [-n|--dry-run] [-r|--repair DIR]
#
# Layout of dest:
#   git_home/<name>/         branch orchestration (managing tree)
#   git_home/<name>/master/  worktree on branch master
#   git_home/<name>/sandbox/ plans / research / PRs / failure logs
#
# Git clone/commit/worktree run as primary_user (sudo -u when needed).
# Root sudo is only for chown/chmod/setuid/fix-perms.
# Never git clone as root. Does not create Unix users. Does not write sudoers.
# Does not mutate the source repo's branches.
#
# ./run-grok-* from a worktree (including master/) needs orch_root= in that
# worktree's project.config. This tool seeds dest and dest/master via
# ve_seed_worktree_project_config. Use --repair on a dest that was cloned
# before that seed existed. --repair seeds project.config, the filter config and
# smudge check, and the dest-root DAC on an existing clone.
#
# Source: --source DIR, else the directory holding this script. It must have
# run-grok-orchestrator, setup_agent.sh, AGENT_MANDATES.md and project.config
# sandbox_dir naming an existing dir. git_home: --git-home, else source git_home
# (--git-home must be an absolute existing directory).
#
# new-name: one path component matching [A-Za-z0-9._-]+, not . .. master
# orchestration or agent-N. Dest git_home/<name> must not already exist.
#
# Examples:
#   ./clone-orchestration-project NEWHOST
#   ./orchestration-example/clone-orchestration-project NEWHOST    # from git_home
#   /path/to/orchestration-example/clone-orchestration-project --source /path/to/orchestration-example NEWHOST
#   ./clone-orchestration-project --repair GIT_HOME/NEWHOST

set -euo pipefail

umask 007

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CWD="$(pwd)"

DRY=0
SOURCE_ARG=""
GIT_HOME_ARG=""
REPAIR_ARG=""
NAME=""

USAGE_LINE="usage: ./clone-orchestration-project [-h] [-n] [-s DIR] [-g DIR] NEW-NAME | [-n] -r DIR"
usage() {
  cat <<EOF
$USAGE_LINE

Clone this orchestration-example tree to git_home/NEW-NAME as a new multi-agent
host (orchestration branch at the dest root, master/ worktree).

options:
  -h, --help          show this help message and exit
  -n, --dry-run       print resolved paths and planned steps; change nothing
  -s, --source DIR    the orchestration-example to clone (default: this script's dir)
  -g, --git-home DIR  git_home to clone into (default: the source's git_home)
  -r, --repair DIR    bring an existing clone DIR up to date instead of cloning

Details: the comment at the top of ./clone-orchestration-project.
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

warn() {
  echo "WARNING: $*" >&2
}

abs_dir() {
  local p="$1"
  [ -d "$p" ] || return 1
  (cd "$p" && pwd)
}

read_config_key() {
  local file="$1" key="$2"
  local val=""
  [ -f "$file" ] || return 1
  val=$(sed -n "s/^${key}=//p" "$file" | tr -d '\r' | head -1)
  [ -n "$val" ] || return 1
  case "$val" in
    @@*) return 1 ;;
  esac
  printf '%s\n' "$val"
}

looks_like_example() {
  local d="$1" sd
  [ -n "$d" ] && [ -d "$d" ] || return 1
  [ -f "$d/run-grok-orchestrator" ] && [ -f "$d/setup_agent.sh" ] && [ -f "$d/AGENT_MANDATES.md" ] || return 1
  sd=$(read_config_key "$d/project.config" sandbox_dir) || return 1
  [ -d "$d/$sd" ]
}

resolve_source() {
  # One source: --source DIR, else the directory holding this script.
  local cand="${SOURCE_ARG:-$SCRIPT_DIR}"
  cand=$(abs_dir "$cand") || die "source is not a directory: $cand"
  looks_like_example "$cand" || die "source is not orchestration-example (needs run-grok-orchestrator, setup_agent.sh, AGENT_MANDATES.md, project.config sandbox_dir): $cand"
  SOURCE="$cand"
}

resolve_git_home() {
  local v=""
  if [ -n "$GIT_HOME_ARG" ]; then
    v="$GIT_HOME_ARG"
  else
    v=$(read_config_key "$SOURCE/project.config" git_home) || die "git_home has no value in $SOURCE/project.config (or pass --git-home)"
  fi
  case "$v" in
    ''|@@*) die "git_home unset or still a @@ token" ;;
    /*) ;;
    ~*|\$HOME*|\$HOME/*)
      die "git_home must be an absolute path, not ~/git or \$HOME/git (got: $v)"
      ;;
    *) die "git_home must be an absolute path (got: $v)" ;;
  esac
  [ -d "$v" ] || die "git_home is not a directory: $v"
  GIT_HOME=$(abs_dir "$v")
}

validate_name() {
  local n="$1"
  [ -n "$n" ] || die "missing <new-name>"
  case "$n" in
    .|..) die "invalid new-name: $n" ;;
    master|orchestration) die "new-name cannot be '$n' (reserved branch/worktree)" ;;
  esac
  [[ "$n" =~ ^[A-Za-z0-9._-]+$ ]] || die "new-name must match [A-Za-z0-9._-]+ (got: $n)"
  if [[ "$n" =~ ^agent-[0-9]+$ ]]; then
    die "new-name cannot be '$n' (reserved for feature worktrees)"
  fi
}

load_source_config() {
  local c="$SOURCE/project.config"
  PRIMARY_USER=$(read_config_key "$c" primary_user) || die "primary_user has no value in $c"
  PLANNING_USER=$(read_config_key "$c" planning_user) || die "planning_user has no value in $c"
  CODER_USER=$(read_config_key "$c" coder_user) || die "coder_user has no value in $c"
  ORCHESTRATOR_USER=$(read_config_key "$c" orchestrator_user) || die "orchestrator_user has no value in $c"
  SANDBOX_REL=$(read_config_key "$c" sandbox_dir) || die "sandbox_dir has no value in $c"
  SPECIAL_PATHS=$(read_config_key "$c" sandbox_special_paths) || die "sandbox_special_paths has no value in $c"
  CODE_GROUP=$(read_config_key "$c" code_group) || die "code_group has no value in $c"
}

require_users() {
  local u
  for u in "$PRIMARY_USER" "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
    if ! id "$u" >/dev/null 2>&1; then
      die "required user '$u' does not exist (this tool does not create Unix users)"
    fi
  done
}

# Git clone/commit/worktree: always primary_user, never root.
as_primary() {
  if [ "$(id -un)" = "$PRIMARY_USER" ]; then
    "$@"
  else
    sudo -u "$PRIMARY_USER" -- "$@"
  fi
}

# chown/chmod/setuid/fix-perms only.
as_root() {
  if [ "$EUID" -eq 0 ]; then
    "$@"
  else
    sudo -- "$@"
  fi
}

git_primary() {
  as_primary git -c safe.directory=* "$@"
}

# Print a planned/executed step. who = primary|root|check
step() {
  local who="$1"
  shift
  echo "  [$who] $*"
}

write_as_primary() {
  local file="$1"
  if [ "$DRY" -eq 1 ]; then
    step primary "write $file"
    cat >/dev/null
    return 0
  fi
  if [ "$(id -un)" = "$PRIMARY_USER" ]; then
    cat > "$file"
  else
    sudo -u "$PRIMARY_USER" -- tee "$file" >/dev/null
  fi
}

upsert_config_key() {
  local file="$1" key="$2" val="$3"
  if [ "$DRY" -eq 1 ]; then
    step primary "set $key=$val in $file"
    return 0
  fi
  as_primary bash -c '
    set -euo pipefail
    file="$1"; key="$2"; val="$3"
    if [ ! -f "$file" ]; then
      printf "%s=%s\n" "$key" "$val" > "$file"
      exit 0
    fi
    if grep -q "^${key}=" "$file"; then
      tmp="${file}.tmp.$$"
      sed "s|^${key}=.*|${key}=${val}|" "$file" > "$tmp"
      mv "$tmp" "$file"
    else
      printf "%s=%s\n" "$key" "$val" >> "$file"
    fi
  ' bash "$file" "$key" "$val"
}

seed_dest_project_configs() {
  step primary "ve_seed_worktree_project_config $DEST $DEST  (orch_root=$DEST)"
  step primary "ve_seed_worktree_project_config $DEST/master $DEST  (orch_root=$DEST)"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  as_primary test -f "$DEST/ve-resolve-orch" || die "ve-resolve-orch missing in $DEST"
  as_primary test -d "$DEST/master" || die "master worktree missing: $DEST/master"
  as_primary bash -c '
    set -euo pipefail
    DEST="$1"
    # shellcheck source=/dev/null
    . "$DEST/ve-resolve-orch"
    ve_seed_worktree_project_config "$DEST" "$DEST"
    ve_seed_worktree_project_config "$DEST/master" "$DEST"
  ' bash "$DEST"
}

verify_dest_orch_root() {
  step check "$DEST/ve-resolve-orch $DEST  (must print $DEST)"
  step check "$DEST/ve-resolve-orch $DEST/master  (must print $DEST)"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  local got
  got=$(as_primary bash "$DEST/ve-resolve-orch" "$DEST") || die "ve-resolve-orch failed for $DEST"
  got="${got//$'\r'/}"
  [ "$got" = "$DEST" ] || die "ve-resolve-orch $DEST printed '$got' (want $DEST)"
  got=$(as_primary bash "$DEST/ve-resolve-orch" "$DEST/master") || die "ve-resolve-orch failed for $DEST/master"
  got="${got//$'\r'/}"
  [ "$got" = "$DEST" ] || die "ve-resolve-orch $DEST/master printed '$got' (want $DEST)"
}

do_fix_perms() {
  # Use this example's fix-perms (not dest's stale copy) with explicit worktrees.
  step root "$SCRIPT_DIR/fix-perms $DEST"
  step root "$SCRIPT_DIR/fix-perms $DEST/master"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  if ! as_root "$SCRIPT_DIR/fix-perms" "$DEST"; then
    die "fix-perms failed: $SCRIPT_DIR/fix-perms $DEST"
  fi
  if ! as_root "$SCRIPT_DIR/fix-perms" "$DEST/master"; then
    die "fix-perms failed: $SCRIPT_DIR/fix-perms $DEST/master"
  fi
}

do_dest_root_dac() {
  step root "chown $PRIMARY_USER:$CODE_GROUP $DEST $DEST/master && chmod 2775 both"
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  if ! as_root chown "$PRIMARY_USER:$CODE_GROUP" "$DEST" "$DEST/master"; then
    die "chown $PRIMARY_USER:$CODE_GROUP failed for dest roots"
  fi
  if ! as_root chmod 2775 "$DEST" "$DEST/master"; then
    die "chmod 2775 failed for dest roots"
  fi
}

do_landlock_exec_dac() {
  local f
  for f in "$DEST/agent-landlock" "$DEST/master/agent-landlock"; do
    step root "chown $PRIMARY_USER:$CODE_GROUP $f && chmod 775 (o+x for ai-planner)"
    if [ "$DRY" -eq 1 ]; then
      continue
    fi
    [ -f "$f" ] || continue
    if ! as_root chown "$PRIMARY_USER:$CODE_GROUP" "$f"; then
      die "chown landlock failed: $f"
    fi
    if ! as_root chmod 775 "$f"; then
      die "chmod 775 landlock failed: $f"
    fi
  done
}

# Absolute dest path without cd (dest may be 770 primary:primary; we cannot enter it).
abs_existing_dir() {
  local p="$1"
  case "$p" in
    /*) ;;
    *) p="$CWD/$p" ;;
  esac
  p="${p%/}"
  [ -d "$p" ] || return 1
  printf '%s\n' "$p"
}

dest_looks_like_clone() {
  local d="$1"
  [ -f "$d/run-grok-orchestrator" ] && [ -f "$d/setup_agent.sh" ] && [ -f "$d/AGENT_MANDATES.md" ] && [ -d "$d/master" ]
}

repair_validate_dest() {
  if dest_looks_like_clone "$DEST"; then
    return 0
  fi
  if [ ! -x "$DEST" ]; then
    if [ "$DRY" -eq 1 ]; then
      step check "dest exists but is not enterable by $(id -un); execute seeds as $PRIMARY_USER"
      return 0
    fi
    if [ "$(id -un)" = "$PRIMARY_USER" ]; then
      die "cannot enter $DEST as $PRIMARY_USER"
    fi
    echo "ERROR: $DEST is not enterable by $(id -un). Trying sudo -u $PRIMARY_USER ..." >&2
    if as_primary bash -c '
      d="$1"
      [ -f "$d/run-grok-orchestrator" ] || exit 1
      [ -f "$d/setup_agent.sh" ] || exit 1
      [ -f "$d/AGENT_MANDATES.md" ] || exit 1
      [ -d "$d/master" ] || exit 1
    ' bash "$DEST"; then
      return 0
    fi
    die "sudo -u $PRIMARY_USER failed. Run as $PRIMARY_USER: ./clone-orchestration-project --repair $DEST"
  fi
  die "--repair DIR does not look like a clone with master/ worktree: $DEST"
}

run_install_merge_drivers() {
  if [ "$DRY" -eq 1 ]; then
    return 0
  fi
  if [ "$(id -un)" = "$PRIMARY_USER" ]; then
    (cd "$DEST" && ./install-merge-drivers.sh)
  else
    sudo -u "$PRIMARY_USER" -- bash -c 'cd "$1" && ./install-merge-drivers.sh' bash "$DEST"
  fi
}

# Filter config (./install-merge-drivers.sh) + re-smudge + check, in one worktree.
smudge_and_verify() {
  local wt="$1"
  step primary "(cd $wt && ./verify-smudge --fix)"
  if [ "$DRY" -eq 0 ]; then
    as_primary bash -c 'cd "$1" && ./verify-smudge --fix' bash "$wt" \
      || die "unsmudged files remain in $wt (see verify-smudge ERROR lines)"
  fi
}

add_safe_directory() {
  local u="$1" path="$2"
  if [ "$DRY" -eq 1 ]; then
    if [ "$(id -un)" = "$u" ]; then
      step "$u" "git config --global --add safe.directory $path"
    else
      step root "sudo -u $u git config --global --add safe.directory $path"
    fi
    return 0
  fi
  if [ "$(id -un)" = "$u" ]; then
    git config --global --add safe.directory "$path" 2>/dev/null || true
  else
    sudo -u "$u" git config --global --add safe.directory "$path" 2>/dev/null || true
  fi
}

write_identity_files() {
  write_as_primary "$DEST/AGENT_CONTEXT.md" <<EOF
# AGENT_CONTEXT.md — master

- **Agent ID:** master
- **Current Branch:** master
- **Role:** Master
- **Sandbox:** ${DEST}/sandbox/
- **Status:** ACTIVE
EOF

  write_as_primary "$DEST/project-facts.md" <<EOF
# project-facts.md — ${NAME}

- Host: multi-agent host cloned from orchestration-example
- Sandbox: \`sandbox/\` (absolute: ${DEST}/sandbox/)
- Layout: \`${DEST}/\` branch \`orchestration\`; \`${DEST}/master/\` branch \`master\`
- git_home: ${GIT_HOME}
- Launch: \`./run-grok-*\` via \`.grok/lib/grok-launch-common.sh\` + \`agent-landlock\`
- Groups: source \`./env\` (refresh-shell setuid)
- Before adding or changing user-visible wording, translations, or the user manual: read \`docs/facts/translations.md\`.
EOF

  write_as_primary "$DEST/README.md" <<EOF
# ${NAME}

Cloned from orchestration-example. Multi-agent orchestration host: launchers,
policies, Landlock helper, group-refresh shell, setup/update/fix tooling.

## Layout

- \`${DEST}/\` — branch \`orchestration\` (managing tree)
- \`${DEST}/master/\` — worktree on branch \`master\`
- \`${DEST}/sandbox/\` — plans, research, PRs, failure logs

## Quick start

\`\`\`bash
source ./env
./setup_agent.sh my-feature
./run-grok-planner
\`\`\`

Landlock (mutation-only) wraps agents via \`agent-landlock\` from \`run-grok*\`.
EOF
}

write_orchestration_context() {
  write_as_primary "$DEST/AGENT_CONTEXT.md" <<EOF
# AGENT_CONTEXT.md — orchestration

- **Agent ID:** orchestration
- **Current Branch:** orchestration
- **Role:** Orchestrator
- **Sandbox:** ${DEST}/sandbox/
- **Status:** ACTIVE
EOF
}

# A fresh clone must be clean in both trees: a dirty master/ makes ./build_app refuse.
require_clean() {
  local wt="$1" st
  step check "git -C $wt status --porcelain is empty"
  [ "$DRY" -eq 0 ] || return 0
  st=$(git_primary -C "$wt" status --porcelain) || die "git status failed in $wt"
  [ -z "$st" ] || die "$wt is not clean after clone:
$st"
}

print_header() {
  echo "=== clone-orchestration-project ==="
  echo "source:       $SOURCE"
  echo "git_home:     $GIT_HOME"
  echo "new-name:     $NAME"
  echo "dest:         $DEST"
  echo "primary_user: $PRIMARY_USER"
  echo "sandbox:      $DEST/$SANDBOX_REL"
  if [ "$DRY" -eq 1 ]; then
    echo "mode:         dry-run (no writes, no sudo)"
  else
    echo "mode:         execute"
  fi
  echo
  echo "Planned steps:"
}

seed_debug_keystore() {
  local src="$SOURCE/.android-shared/debug.keystore"
  local dest_dir="$DEST/.android-shared"
  if [ ! -f "$src" ]; then
    warn "no $src"
    warn "run-grok-* fails until debug.keystore is at $dest_dir/debug.keystore"
    return 0
  fi
  step primary "cp debug.keystore to $dest_dir/debug.keystore"
  if [ "$DRY" -eq 0 ]; then
    as_primary mkdir -p -m 2770 "$dest_dir"
    as_primary cp "$src" "$dest_dir/debug.keystore"
    as_primary chmod 660 "$dest_dir/debug.keystore"
  fi
}

seed_sandbox_repo() {
  local sandbox="$DEST/$SANDBOX_REL"
  local meta="${GIT_HOME}/${NAME}.sandboxmetadata"
  local gitdir="$meta/git"

  # The sandbox is a dir in the root and a symlink in master/, so the pattern is the bare name
  # (no leading or trailing slash): it matches both, and the manage-configs clean filter stores
  # it as @@SANDBOX_PATH@@. A leading-slash form stays literal in git. Canon's .gitignore already
  # has all three lines (smudged by the clone), so normally nothing is appended here.
  # /master/ and /agent-*/: worktrees inside the root tree.
  step primary "ensure $DEST/.gitignore ignores ${SANDBOX_REL} /master/ /agent-*/"
  if [ "$DRY" -eq 0 ]; then
    as_primary bash -c '
      file="$1"; shift
      touch "$file"
      for line in "$@"; do
        grep -qxF "$line" "$file" && continue
        if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then
          printf "\n" >> "$file"
        fi
        printf "%s\n" "$line" >> "$file"
      done
    ' bash "$DEST/.gitignore" "${SANDBOX_REL}" "/master/" "/agent-*/"
  fi

  step primary "stop tracking ${SANDBOX_REL}/ in the product repository"
  if [ "$DRY" -eq 0 ]; then
    git_primary -C "$DEST" add -- .gitignore
    git_primary -C "$DEST" rm -r --cached --ignore-unmatch -- "$SANDBOX_REL"
    if ! git_primary -C "$DEST" diff --cached --quiet; then
      git_primary -C "$DEST" commit -m "Keep the sandbox in its own repository"
    fi
  fi

  if [ -e "$sandbox/.git" ]; then
    step check "sandbox git already present"
    return 0
  fi
  if [ -L "$sandbox" ]; then
    warn "$sandbox is a symlink; not creating a nested git dir"
    return 0
  fi
  step primary "git init --separate-git-dir $gitdir $sandbox"
  if [ "$DRY" -eq 0 ]; then
    as_primary mkdir -p "$sandbox" "$meta"
    as_primary chmod 700 "$meta"
    as_primary git -c init.defaultBranch=master init --separate-git-dir "$gitdir" "$sandbox"
    as_primary chmod -R go-rwx "$meta"
    if [ -f "$sandbox/.git" ]; then
      as_primary chmod 644 "$sandbox/.git"
    fi
  fi
}

do_clone_layout() {
  step primary "git -c safe.directory=* clone --no-hardlinks -- $SOURCE $DEST"
  if [ "$DRY" -eq 0 ]; then
    git_primary clone --no-hardlinks -- "$SOURCE" "$DEST"
  fi
  # The template is not the new project's remote: its refs block history rewrites and invite pushes to canon.
  step primary "git remote remove origin"
  if [ "$DRY" -eq 0 ]; then
    git_primary -C "$DEST" remote remove origin
  fi

  [ -f "$SOURCE/project.config" ] || die "$SOURCE/project.config missing (copy project.config.example and fill it first)"
  step primary "cp $SOURCE/project.config $DEST/project.config"
  if [ "$DRY" -eq 0 ]; then
    as_primary cp "$SOURCE/project.config" "$DEST/project.config"
  fi
  upsert_config_key "$DEST/project.config" orch_root "$DEST"
  if [ -n "$GIT_HOME_ARG" ]; then
    upsert_config_key "$DEST/project.config" git_home "$GIT_HOME"
  fi

  # The clone checked out raw @@TOKEN@@ files (no filter config yet). Configure, then smudge.
  step primary "git config core.sharedRepository=group; ./install-merge-drivers.sh (merge drivers + manage-configs filter, required=true)"
  if [ "$DRY" -eq 0 ]; then
    git_primary -C "$DEST" config core.sharedRepository group
  fi
  run_install_merge_drivers
  smudge_and_verify "$DEST"
  seed_debug_keystore

  step primary "rewrite AGENT_CONTEXT.md project-facts.md README.md for $NAME"
  write_identity_files

  step primary "git add AGENT_CONTEXT.md project-facts.md README.md && git commit -m 'Host identity for $NAME'"
  if [ "$DRY" -eq 0 ]; then
    git_primary -C "$DEST" add AGENT_CONTEXT.md project-facts.md README.md
    git_primary -C "$DEST" commit -m "Host identity for $NAME"
  fi

  seed_sandbox_repo

  # Each step line is printed right before its command, so git's own output follows its step.
  step primary "git checkout -b orchestration"
  [ "$DRY" -eq 1 ] || git_primary -C "$DEST" checkout -b orchestration
  step primary "commit AGENT_CONTEXT.md (orchestration identity)"
  if [ "$DRY" -eq 0 ]; then
    write_orchestration_context
    git_primary -C "$DEST" commit -m "Orchestration identity for $NAME" -- AGENT_CONTEXT.md
  fi
  step primary "git worktree add --no-checkout $DEST/master master"
  if [ "$DRY" -eq 0 ]; then
    git_primary -C "$DEST" worktree add --no-checkout "$DEST/master" master
  fi

  # project.config before checkout: the smudge filter needs it.
  seed_dest_project_configs
  # The filter scripts first: git runs ./filter-*-config from the worktree being populated.
  step primary "git -C $DEST/master checkout HEAD -- filter-apply-config filter-clean-config && checkout HEAD -- ."
  if [ "$DRY" -eq 0 ]; then
    git_primary -C "$DEST/master" checkout HEAD -- filter-apply-config filter-clean-config
    git_primary -C "$DEST/master" checkout HEAD -- .
  fi
  smudge_and_verify "$DEST/master"
  verify_dest_orch_root

  step primary "ln -sfn ../sandbox $DEST/master/sandbox"
  if [ "$DRY" -eq 0 ]; then
    if [ -d "$DEST/master/sandbox" ] && [ ! -L "$DEST/master/sandbox" ]; then
      as_primary rm -rf "$DEST/master/sandbox"
    fi
    as_primary ln -sfn ../sandbox "$DEST/master/sandbox"
  fi

  step primary "mkdir -p sandbox specials ($SPECIAL_PATHS)"
  if [ "$DRY" -eq 0 ]; then
    as_primary mkdir -p "$DEST/$SANDBOX_REL"
    local p
    IFS=',' read -r -a _sp <<< "$SPECIAL_PATHS"
    for p in "${_sp[@]}"; do
      p="${p#"${p%%[![:space:]]*}"}"
      p="${p%"${p##*[![:space:]]}"}"
      [ -n "$p" ] || continue
      as_primary mkdir -p "$DEST/$SANDBOX_REL/$p"
    done
  fi

  step primary "install hooks/post-checkout -> $DEST/.git/hooks/post-checkout (775)"
  if [ "$DRY" -eq 0 ]; then
    [ -f "$DEST/hooks/post-checkout" ] || die "hooks/post-checkout not tracked in $DEST (publish rules to the source first)"
    as_primary cp "$DEST/hooks/post-checkout" "$DEST/.git/hooks/post-checkout"
    as_primary chmod 775 "$DEST/.git/hooks/post-checkout"
  fi

  # Hook installed: from now on every checkout runs ./verify-smudge.
  smudge_and_verify "$DEST"
  smudge_and_verify "$DEST/master"
  require_clean "$DEST"
  require_clean "$DEST/master"
}

do_perms() {
  do_fix_perms
  do_dest_root_dac
  do_landlock_exec_dac

  step root "$DEST/install-refresh-shell.sh $DEST"
  step root "$DEST/install-refresh-shell.sh $DEST/master"
  if [ "$DRY" -eq 0 ]; then
    as_root "$DEST/install-refresh-shell.sh" "$DEST"
    as_root "$DEST/install-refresh-shell.sh" "$DEST/master"
  fi

  local u
  for u in "$PRIMARY_USER" "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
    add_safe_directory "$u" "$DEST"
    add_safe_directory "$u" "$DEST/*"
  done

}

# --- args ---
# getopt errors go to a variable, not a temp file (stdout is discarded only here; the parse below keeps it).
if ! _cl_err=$(getopt -o hns:g:r: -l help,dry-run,source:,git-home:,repair: -- "$@" 2>&1 >/dev/null); then
  if printf '%s\n' "$_cl_err" | grep -q 'requires an argument'; then
    _cl_opt=$(printf '%s\n' "$_cl_err" | sed -n "s/.*'\\(--[^']*\\)'.*/\\1/p; s/.*option requires an argument -- '\\([^']*\\)'.*/-\\1/p" | head -1)
    case "$_cl_opt" in
      --source|-s) die "--source requires a directory" ;;
      --git-home|-g) die "--git-home requires a directory" ;;
      --repair|-r) die "--repair requires a directory" ;;
      *) die "${_cl_opt:-option} requires a directory" ;;
    esac
  fi
  _cl_bad=$(printf '%s\n' "$_cl_err" | sed -n "s/.*'\\([^']*\\)'.*/\\1/p" | head -1)
  echo "$USAGE_LINE" >&2
  echo "clone-orchestration-project: error: unrecognized option: ${_cl_bad:-?}" >&2
  exit 2
fi
parsed=$(getopt -o hns:g:r: -l help,dry-run,source:,git-home:,repair: -- "$@")
eval set -- "$parsed"
while true; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -n|--dry-run) DRY=1; shift ;;
    -s|--source)
      [ -n "${2:-}" ] || die "--source requires a directory"
      SOURCE_ARG="$2"; shift 2 ;;
    -g|--git-home)
      [ -n "${2:-}" ] || die "--git-home requires a directory"
      GIT_HOME_ARG="$2"; shift 2 ;;
    -r|--repair)
      [ -n "${2:-}" ] || die "--repair requires a directory"
      REPAIR_ARG="$2"; shift 2 ;;
    --) shift; break ;;
    *) echo "$USAGE_LINE" >&2; echo "clone-orchestration-project: error: unrecognized option: $1" >&2; exit 2 ;;
  esac
done
while [ $# -gt 0 ]; do
  if [ -z "$NAME" ]; then
    NAME="$1"
  else
    die "unexpected argument: $1"
  fi
  shift
done

if [ -n "$REPAIR_ARG" ]; then
  [ -z "$NAME" ] || die "do not pass <new-name> with --repair"
  resolve_source
  load_source_config
  require_users
  DEST=$(abs_existing_dir "$REPAIR_ARG") || die "--repair is not a directory: $REPAIR_ARG"
  NAME="$(basename "$DEST")"
  GIT_HOME="$(dirname "$DEST")"
  repair_validate_dest
  print_header
  seed_dest_project_configs
  run_install_merge_drivers
  smudge_and_verify "$DEST"
  smudge_and_verify "$DEST/master"
  seed_debug_keystore
  seed_sandbox_repo
  verify_dest_orch_root
  do_fix_perms
  do_dest_root_dac
  do_landlock_exec_dac
  echo
  if [ "$DRY" -eq 1 ]; then
    echo "Dry-run complete. No files written."
  else
    echo "Repaired $DEST"
    echo "  ve-resolve-orch from dest and dest/master must print $DEST"
    echo "  Next: $DEST/master/run-grok-planner"
  fi
  exit 0
fi

if [ -z "$NAME" ]; then
  echo "$USAGE_LINE" >&2
  echo "clone-orchestration-project: error: NEW-NAME is required" >&2
  exit 1
fi

validate_name "$NAME"
resolve_source
resolve_git_home
load_source_config
require_users

DEST="$GIT_HOME/$NAME"

if [ -e "$DEST" ]; then
  die "dest already exists: $DEST (use --repair $DEST to seed config + DAC)"
fi
if [ -e "$GIT_HOME/$NAME.sandboxmetadata" ]; then
  die "$GIT_HOME/$NAME.sandboxmetadata exists (left by an earlier clone of $NAME?); remove it first"
fi

print_header
do_clone_layout
do_perms

echo
if [ "$DRY" -eq 1 ]; then
  echo "Dry-run complete. No files written."
else
  echo "Created $DEST"
  echo "  HEAD should be orchestration; master worktree at $DEST/master"
  echo "  Next: cd $DEST && source ./env"
fi
