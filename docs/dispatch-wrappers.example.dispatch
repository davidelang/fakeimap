# Sidecar for sandbox/connect/<workspace>/config.diag (copy to config.diag.dispatch beside it).
# Read by the dispatcher only; the channel never reads it. Relative paths resolve from
# this file's real directory (the sandbox is often a symlink), so use absolute paths. Users, Landlock and the
# context window are NOT set here: orch/dispatch-launch-hook takes them from
# project.config and roles.config.

executor.node=coder
executor.max_turns=80
executor.rounds=3
executor.require_commit=yes
# The builds tag must point at HEAD for a plan to count as done (build_app sets it).
executor.done_tag=builds
# Project steps every executor prompt gets (preflight, compliance block).
executor.addendum=/path/to/worktree/docs/dispatch-executor-addendum.md
# Project role cards instead of the dispatcher's generic ones.
executor.rules=/path/to/worktree/roles/executor.md
review.conformance.rules=/path/to/worktree/roles/reviewer.md
review.conformance.max_turns=40

# A non-blocking tester run after COMPLETE; reports a FAIL to the planner.
# review.tests.role=tester
# review.tests.blocking=no
# review.tests.rules=/path/to/worktree/roles/tester.md
# review.tests.on_fail_verb=FAILURE
