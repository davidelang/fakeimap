#!/bin/bash
# run-antigravity-planner — Antigravity CLI (agy) launcher, role planner (no project rules in this file).
# Rules: AGENTS.md (auto-loaded as GEMINI.md) + roles/planner.md (-i); Landlock + env via grok-launch-common.sh
set -euo pipefail
GROK_LAUNCHER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export GROK_LAUNCHER_DIR
ROLE_KEY=planner
export ROLE_KEY
# shellcheck source=/dev/null
source "$GROK_LAUNCHER_DIR/.grok/lib/grok-launch-common.sh"
antigravity_launch_main "$@"
