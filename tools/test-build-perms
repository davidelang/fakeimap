#!/usr/bin/env bash
# Tests for build_app's permission handling (build-examples/android-gradle/build_app + perm-lib.sh).
# Stand-ins only: a fake ./gradlew writes the outputs, ve-resolve-orch is a stub, and the
# "primary user" whose read access is checked is 'nobody' (a computed check; nothing is run as
# another user, no sudo). Runs as the current user, who must be in ai-code and ai-shared
# (build_app requires both) and is coder_user in the throwaway project.config.
set -uo pipefail
canon="$(git rev-parse --show-toplevel)"
T="$("$(dirname "$0")/scratch-dir" buildperms-test)" || exit 1
export GIT_CEILING_DIRECTORIES="$(dirname "$T")"; trap 'chmod -R u+rwx "$T"; rm -rf "$T"' EXIT
chmod 755 "$T"
pass=0 fail=0
ok()  { pass=$((pass+1)); echo "ok   $*"; }
SW='2>/dev/null || true'  # audit-swallow: pattern (what the no-swallow checks grep for)
bad() { fail=$((fail+1)); echo "FAIL $*"; }
me=$(id -un)
JDK=/usr/lib/jvm/java-17-openjdk-amd64

grep -n -F "$SW" "$canon/build-examples/android-gradle/build_app" "$canon/perm-lib.sh" >"$T/sw" \
  && bad "error swallowing: $(cat "$T/sw")" || ok "no swallow idiom in build_app or perm-lib.sh"
grep -n 'o-rwx\|umask 007' "$canon/build-examples/android-gradle/build_app" >"$T/sw" \
  && bad "build_app still forces group-only modes: $(cat "$T/sw")" || ok "build_app forces no o-rwx / umask 007"

mk() {  # fresh worktree repo in $W
  W="$T/wt"; if [ -d "$W" ]; then chmod -R u+rwx "$W"; rm -rf "$W"; fi; mkdir -p "$W/app/src/main"
  cp "$canon/build-examples/android-gradle/build_app" "$canon/build-examples/android-gradle/android-build-info" "$canon/perm-lib.sh" "$canon/perm-engine.py" "$canon/perm-model.tsv" "$W/"
  cat >"$W/ve-resolve-orch" <<'S'
ve_resolve_orch() { ORCH_ROOT="$1"; }
ve_setup_worktree_build_homes() { mkdir -p "$1/.gradle-home"; export GRADLE_USER_HOME="$1/.gradle-home"; }
ve_aapt2_from_sdk() { echo /bin/true; }
ve_reset_gradle_daemon_dir() { return 0; }
ve_wipe_foreign_app_build_outputs() { return 0; }
S
  cat >"$W/gradlew" <<'G'
#!/bin/bash
# stand-in gradle: records its umask, writes the outputs the tasks name
[[ " $* " == *" --stop "* ]] && exit 0
umask >"$GRADLE_USER_HOME/gradle-umask"
[ -f "$GRADLE_USER_HOME/fail" ] && exit 1
for a in "$@"; do
  case "$a" in
    assembleDebug) mkdir -p app/build/outputs/apk/debug app/build/intermediates/x
                   echo apk >app/build/outputs/apk/debug/app-debug.apk
                   printf '{"version":3,"artifactType":{"type":"APK","kind":"Directory"},"applicationId":"com.ex.app","variantName":"debug","elements":[{"type":"SINGLE","filters":[],"versionName":"1.0","outputFile":"app-debug.apk"}]}\n' >app/build/outputs/apk/debug/output-metadata.json
                   echo i >app/build/intermediates/x/f ;;
    failBuild) exit 1 ;;
  esac
done
G
  chmod 755 "$W/gradlew"
  cat >"$W/project.config" <<C
primary_user=nobody
coder_user=$me
planning_user=ai-planner
java_home=$JDK
code_group=ai-code
shared_group=ai-shared
sandbox_group=ai-sandbox
C
  printf '%s\n' '## Build and commit' '- **Standard build:** debug' '- **Test build:** none' >"$W/project-facts.md"
  echo src >"$W/app/src/main/a.txt"
  printf 'project.config\n.gradle-home/\napp/build/\n' >"$W/.gitignore"   # as in real projects
  git -C "$W" init -q -b master && git -C "$W" add -A && git -C "$W" -c user.name=t -c user.email=t@t commit -qm init
}
build() { (cd "$W" && env -u GRADLE_USER_HOME PATH="$PATH" ./build_app --standard </dev/null) >"$T/out" 2>&1; }

mk
# leftover from the old build_app: group-only output dirs
mkdir -p "$W/app/build/outputs/apk/debug"; chmod 2770 "$W/app/build" "$W/app/build/outputs" "$W/app/build/outputs/apk" "$W/app/build/outputs/apk/debug"
build; rc=$?
[[ $rc -eq 0 ]] && ok "standard build rc 0" || bad "standard build rc=$rc: $(tail -20 "$T/out")"
[[ "$(cat "$W/.gradle-home/gradle-umask")" == 0002 ]] && ok "gradle ran with umask 0002" || bad "gradle umask $(cat "$W/.gradle-home/gradle-umask")"
[[ "$(stat -c %a "$W/app/build/outputs/apk/debug/app-debug.apk")" == 644 ]] && ok "APK is 644" || bad "APK mode $(stat -c %a "$W/app/build/outputs/apk/debug/app-debug.apk")"
[[ "$(stat -c %a "$W/app/build/outputs/apk/debug/output-metadata.json")" == 644 ]] && ok "output-metadata.json is 644" || bad "metadata mode"
[[ "$(stat -c %G "$W/app/build/outputs/apk/debug/app-debug.apk")" == ai-code ]] && ok "APK group ai-code" || bad "APK group $(stat -c %G "$W/app/build/outputs/apk/debug/app-debug.apk")"
x=1; for d in app app/build app/build/outputs app/build/outputs/apk app/build/outputs/apk/debug; do
  [[ $(( 0$(stat -c %a "$W/$d") & 05 )) -eq 5 ]] || { x=0; bad "$d not o+rx: $(stat -c %a "$W/$d")"; }
done; [[ $x -eq 1 ]] && ok "every dir down to the APK is o+rx (was 2770)"
grep -q 'Deliverables readable by nobody without group membership' "$T/out" && ok "no-groups read check reported" || bad "no read-check line: $(tail -5 "$T/out")"
[[ "$(stat -c %a "$W/app/build/intermediates/x/f")" == 664 ]] && ok "intermediates keep umask modes (664, 'other' not stripped)" || bad "intermediate mode $(stat -c %a "$W/app/build/intermediates/x/f")"
[[ $(( 0$(stat -c %a "$W/app/build/intermediates") & 02000 )) -ne 0 ]] && ok "intermediate dirs setgid" || bad "intermediates not setgid"

# A directory above the worktree that 'other' cannot search: the check fails loudly.
chmod 750 "$T"
build; rc=$?
chmod 755 "$T"
[[ $rc -ne 0 ]] && grep -q "NOT-READABLE user=nobody .* blocker=$T class=other" "$T/out" && ok "unreadable path fails the build, naming the blocker (rc $rc)" || bad "blocked path: rc=$rc $(tail -5 "$T/out")"

# The source tree is not the build's: an editor's swap file (any owner, any mode) and a directory
# nobody can read under app/src are never walked, changed or named, and the build succeeds.
mk; mkdir -p "$W/app/src/main/assets" "$W/app/src/main/locked"
echo swap >"$W/app/src/main/assets/.settings-tree.json.swp"; chmod 0600 "$W/app/src/main/assets/.settings-tree.json.swp"
chmod 0000 "$W/app/src/main/locked"
build; rc=$?
chmod 0755 "$W/app/src/main/locked"
[[ $rc -eq 0 ]] && ok "stray swap file and unreadable dir in app/src do not stop the build" || bad "app/src stray: rc=$rc $(tail -5 "$T/out")"
[[ "$(stat -c %a "$W/app/src/main/assets/.settings-tree.json.swp")" == 600 ]] && ok "swap file left at its own mode (600)" || bad "swap mode changed to $(stat -c %a "$W/app/src/main/assets/.settings-tree.json.swp")"
grep -q 'settings-tree.json.swp\|app/src/main/locked' "$T/out" && bad "output names a file the build does not own: $(grep 'swp\|locked' "$T/out")" || ok "output never names the stray files"

# Caller != coder_user and the re-exec cannot happen: the build fails loudly and nothing is built
# as the caller (no fallback). coder_user names a user that does not exist, so sudo -n always fails.
mk; sed -i "s/^coder_user=.*/coder_user=no-such-user-zz/" "$W/project.config"
build; rc=$?
[[ $rc -ne 0 ]] && grep -q 'Re-executing as no-such-user-zz' "$T/out" && [ ! -e "$W/app/build" ] && [ ! -e "$W/.gradle-home" ] \
  && ok "failed re-exec as coder_user stops before any build work (rc $rc, no app/build or .gradle-home)" || bad "re-exec failure: rc=$rc $(tail -5 "$T/out"); $(ls -a "$W")"

# A deliverable chmod failure surfaces with chmod's error and the path's owner/mode.
mk
mkdir -p "$T/shim"; printf '#!/bin/sh\ncase "$*" in *app-debug.apk*) echo "chmod: forced failure" >&2; exit 1;; esac\nexec /usr/bin/chmod "$@"\n' >"$T/shim/chmod"; chmod 755 "$T/shim/chmod"
(cd "$W" && env -u GRADLE_USER_HOME PATH="$T/shim:$PATH" ./build_app --standard </dev/null) >"$T/out" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q 'forced failure' "$T/out" && grep -q "perm-lib: 'chmod 00644 .*app-debug.apk' failed" "$T/out" && ok "failing chmod on a deliverable stops the build (rc $rc)" || bad "chmod failure: rc=$rc $(tail -5 "$T/out")"
grep -q "Updating 'builds' tag" "$T/out" && bad "builds tag moved after a failure" || ok "builds tag not moved after the failure"

# A failed gradle run still repairs, then fails.
mk; mkdir -p "$W/.gradle-home"; : >"$W/.gradle-home/fail"
build; rc=$?
[[ $rc -ne 0 ]] && grep -q 'Build failed (standard)' "$T/out" && ok "gradle failure exits non-zero" || bad "gradle failure rc=$rc $(tail -5 "$T/out")"

# The build is recorded for deploy (android-build-info stamp from output-metadata.json).
mk; build; rc=$?
[[ $rc -eq 0 ]] && python3 -c "import json,sys; d=json.load(open('$W/app/build/outputs/build_app/standard.json')); sys.exit(0 if d['commit']=='$(git -C "$W" rev-parse HEAD)' and d['entries'][0]['application_id']=='com.ex.app' else 1)" \
  && ok "standard build recorded with commit and app id" || bad "stamp: rc=$rc $(tail -5 "$T/out")"

# Single-user mode: no project.config, or one with @@TOKEN@@ values.
mk; rm "$W/project.config"; build; rc=$?
[[ $rc -eq 0 ]] && grep -q 'NOTICE: single-user mode: no project.config' "$T/out" && ! grep -q 'Re-executing\|Deliverables readable' "$T/out" \
  && [ -f "$W/app/build/outputs/build_app/standard.json" ] && ok "single-user: no project.config builds without sudo/perm model, says why" || bad "single-user: rc=$rc $(tail -8 "$T/out")"
grep -q 'java_home not set: using the OS default java' "$T/out" && ok "single-user: OS default java used and printed" || bad "java default: $(grep -i java "$T/out")"
mk; printf 'primary_user=@@PRIMARY_USER@@\ncoder_user=@@CODER_USER@@\n' >"$W/project.config"; build; rc=$?
[[ $rc -eq 0 ]] && grep -q 'unsmudged @@TOKEN@@' "$T/out" && ok "single-user: unsmudged project.config" || bad "smudge: rc=$rc $(tail -5 "$T/out")"
mk; rm "$W/project.config"; (cd "$W" && env -u GRADLE_USER_HOME PATH="$PATH" ./build_app --play </dev/null) >"$T/out" 2>&1; rc=$?
[[ $rc -ne 0 ]] && ok "single-user: --play without a terminal refused" || bad "play tty: rc=$rc"
mk; rm "$W/project.config"; (cd "$W" && env -u GRADLE_USER_HOME PATH="$PATH" script -qec "./build_app --play" /dev/null </dev/null) >"$T/out" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q 'single-user mode; these signing keys were not given: release_keystore release_key_alias release_bundle_task release_bundle_path' "$T/out" && ok "single-user --play names every missing key" || bad "play keys: rc=$rc $(tail -5 "$T/out")"
mk; printf '%s\n' '## Build and commit' '- **Standard build:** debug' >"$W/project-facts.md"; git -C "$W" -c user.name=t -c user.email=t@t commit -qam facts; build; rc=$?
[[ $rc -ne 0 ]] && grep -q "Test build:\*\*' line" "$T/out" && ! grep -q '=== standard build' "$T/out" && ok "missing declaration line stops before any build" || bad "decl: rc=$rc $(tail -5 "$T/out")"
mk; (cd "$W" && env -u GRADLE_USER_HOME PATH="$PATH" ./build_app --test </dev/null) >"$T/out" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q "declares '- \*\*Test build:\*\* none'" "$T/out" && ok "--test with Test build none refused" || bad "test none: rc=$rc $(tail -3 "$T/out")"

# '@@' in a comment of a smudged project.config (torque's has two) is not single-user mode.
mk; printf '# Notes for filters: use @@VAR@@ in source scripts for substitution.\n' >>"$W/project.config"; build; rc=$?
[[ $rc -eq 0 ]] && ! grep -q 'single-user' "$T/out" && grep -q 'Deliverables readable' "$T/out" && ok "@@ in a comment keeps multi-user mode" || bad "@@ comment: rc=$rc $(grep -i 'single\|ERROR' "$T/out")"
# build_app checks build-intermediates ownership before the commit phase.
awk '/perm_preflight build-intermediates/{p=NR} /^if \[ "\$#" -ge 1 \]; then/{c=NR} END{exit !(p && c && p<c)}' "$W/build_app" \
  && ok "build_app runs perm_preflight before the commit phase" || bad "preflight not before commit phase"

# perm-lib unit checks
. "$canon/perm-lib.sh"; perm_init "$W/project.config"
mkdir -p "$T/pf/d"; chmod 0755 "$T/pf/d"
perm_preflight build-intermediates "$T/pf/d" --top-only >"$T/o" 2>&1 && [ ! -s "$T/o" ] && ok "preflight: own path with the wrong mode is fixable (no output)" || bad "pf own: $(cat "$T/o")"
perm_preflight build-intermediates /etc --top-only >"$T/o" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q '^CANNOT-FIX area=build-intermediates path=/etc got=root:root' "$T/o" && grep -q "have each owner remove the ones that are not needed, or run ./fix-perms" "$T/o" && ! grep -q sudo "$T/o" && ok "preflight: someone else's path with the wrong mode/owner is CANNOT-FIX, hint given" || bad "pf foreign: $(cat "$T/o")"
sed "s/^coder_user=.*/coder_user=nobody/" "$W/project.config" >"$T/pc-nobody"
( perm_init "$T/pc-nobody"; perm_preflight build-intermediates "$T/pf/d" --top-only ) >"$T/o" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q 'owner should be nobody:ai-code' "$T/o" && ok "preflight: build outputs owned by someone other than coder_user are CANNOT-FIX" || bad "pf owner: $(cat "$T/o")"
perm_apply deliverable-dirs /etc --top-only >"$T/o" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q "is not owned by $me, so only root can change it: run ./fix-perms from the orchestration root" "$T/o" && ok "failing chmod on another user's path names the fix" || bad "apply hint: $(cat "$T/o")"
# readable-nogroups evaluates POSIX ACLs (acl(5)), not "any ACL = unreadable".
mkdir -p "$T/acl/d"; : >"$T/acl/d/f"; chmod 755 "$T/acl" "$T/acl/d"; chmod 644 "$T/acl/d/f"
setfacl -m u:ai-planner:r-x "$T/acl"
perm_readable_nogroups nobody "$T/acl/d/f" >"$T/o" 2>&1 && ok "ACL for another user (like VE root's user:ai-planner:r-x) does not block 'other'" || bad "acl other: $(cat "$T/o")"
setfacl -m u:nobody:--- "$T/acl"
perm_readable_nogroups nobody "$T/acl/d/f" >"$T/o" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q "blocker=$T/acl class=acl-user" "$T/o" && ok "named-user ACL entry --- blocks that user" || bad "acl user: rc=$rc $(cat "$T/o")"
setfacl -m u:nobody:r-x,m:--- "$T/acl"
perm_readable_nogroups nobody "$T/acl/d/f" >"$T/o" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q 'class=acl-user' "$T/o" && ok "mask limits a named-user entry" || bad "acl mask: rc=$rc $(cat "$T/o")"
setfacl -b "$T/acl"; setfacl -m u:ai-planner:r-x "$T/acl"; chmod o-x "$T/acl"
perm_readable_nogroups nobody "$T/acl/d/f" >"$T/o" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q "blocker=$T/acl class=other" "$T/o" && ok "ACL dir without o+x still blocks 'other'" || bad "acl no-ox: rc=$rc $(cat "$T/o")"
perm_readable_nogroups $me "$T/acl/d/f" >"$T/o" 2>&1 && ok "owner reads through an ACL dir" || bad "acl owner: $(cat "$T/o")"
grep -q $'^build-intermediates\tcoder_user\t' "$canon/perm-model.tsv" && ok "model: build-intermediates owned by coder_user" || bad "model owner"
mkdir -p "$T/u/a/b"; : >"$T/u/a/b/f"; chmod 700 "$T/u/a"
perm_readable_nogroups nobody "$T/u/a/b/f" >"$T/o" 2>&1 && bad "readable check passed through a 700 dir" || ok "readable check: 700 dir blocks 'other'"
perm_verify deliverables "$T/u/a/b/f" --top-only >"$T/o" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q '^PERM-MISMATCH area=deliverables' "$T/o" && ok "perm_verify lists the mismatch" || bad "verify: $(cat "$T/o")"
perm_apply deliverables "$T/u/a/b/f" --top-only && perm_verify deliverables "$T/u/a/b/f" --top-only >/dev/null && ok "perm_apply then perm_verify agree" || bad "apply/verify disagree"
perm_umask nosucharea >"$T/o" 2>&1 && bad "unknown area accepted" || grep -q "unknown area 'nosucharea'" "$T/o" && ok "unknown area is an error"
perm_umask englog >"$T/o" 2>&1 && bad "area without umask returned one" || ok "area without a umask is an error"
mkdir -p "$T/p/keep" "$T/p/other" "$T/p/.git"; : >"$T/p/other/f"; : >"$T/p/.git/f"; : >"$T/p/keep/f"; chmod 600 "$T/p/other/f" "$T/p/.git/f" "$T/p/keep/f"
perm_apply worktree "$T/p" --prune "$T/p/other" --prune-name .git
[[ "$(stat -c %a "$T/p/keep/f")" == 664 && "$(stat -c %a "$T/p/other/f")" == 600 && "$(stat -c %a "$T/p/.git/f")" == 600 ]] && ok "--prune and --prune-name are never entered" || bad "prune: keep=$(stat -c %a "$T/p/keep/f") other=$(stat -c %a "$T/p/other/f") git=$(stat -c %a "$T/p/.git/f")"

# Hard links to someone else's file (Gradle links the NDK's libc++_shared.so into app/build):
# never chowned or chmodded, since that would change the file outside the tree too.
mkdir -p "$T/hl/ndk" "$T/hl/d"; printf x >"$T/hl/ndk/lib.so"; chmod 600 "$T/hl/ndk/lib.so"; ln "$T/hl/ndk/lib.so" "$T/hl/d/lib.so"
( perm_init "$T/pc-nobody"; perm_apply build-intermediates "$T/hl/d/lib.so" --top-only ) >"$T/o" 2>&1; rc=$?
[[ $rc -eq 0 && "$(stat -c %a "$T/hl/ndk/lib.so")" == 600 ]] && grep -q "left 1 hard-linked file(s) owned by $me unchanged" "$T/o" \
  && ok "apply: hard link to another owner's file is left unchanged, with a note" || bad "hardlink apply: rc=$rc mode=$(stat -c %a "$T/hl/ndk/lib.so") $(cat "$T/o")"
( perm_init "$T/pc-nobody"; perm_preflight build-intermediates "$T/hl/d/lib.so" --top-only ) >"$T/o" 2>&1; rc=$?
[[ $rc -eq 0 ]] && ! grep -q CANNOT-FIX "$T/o" && ok "preflight: hard link to another owner's readable file is not CANNOT-FIX" || bad "hardlink preflight: rc=$rc $(cat "$T/o")"
chmod 000 "$T/hl/ndk/lib.so"
( perm_init "$T/pc-nobody"; perm_preflight build-intermediates "$T/hl/d/lib.so" --top-only ) >"$T/o" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q "^CANNOT-READ area=build-intermediates path=$T/hl/d/lib.so" "$T/o" && ! grep -q 'sudo\|fix-perms' "$T/o" \
  && ok "preflight: unreadable hard-linked file is CANNOT-READ, owner named, no root hint" || bad "hardlink unreadable: rc=$rc $(cat "$T/o")"
chmod 600 "$T/hl/ndk/lib.so"
perm_apply build-intermediates "$T/hl/d/lib.so" --top-only --owner "$me" >"$T/o" 2>&1; rc=$?
[[ $rc -eq 0 && "$(stat -c %a "$T/hl/ndk/lib.so")" == 660 ]] && ok "apply: a hard-linked file the area owner owns is still fixed" || bad "hardlink own: rc=$rc mode=$(stat -c %a "$T/hl/ndk/lib.so") $(cat "$T/o")"

echo "passed $pass failed $fail"
[[ $fail -eq 0 ]]
