#!/usr/bin/env bash
# Tests for build_app --play: versionCode used as committed, bumped + committed after the bundle (no tag), deliverable
# modes, and no bump when the build fails. Stand-ins: a fake ./gradlew that writes a
# jar-signed AAB with the injected signing env (jarsigner from the JDK), a stub ve-resolve-orch,
# a throwaway keystore; passwords are typed into a pty by script(1). No sudo, no real gradle.
set -uo pipefail
canon="$(git rev-parse --show-toplevel)"
T="$(mktemp -d /tmp/buildplay-test.XXXXXX)"; trap 'chmod -R u+rwx "$T"; rm -rf "$T"' EXIT
chmod 755 "$T"
pass=0 fail=0
ok()  { pass=$((pass+1)); echo "ok   $*"; }
bad() { fail=$((fail+1)); echo "FAIL $*"; }
me=$(id -un)
JDK=/usr/lib/jvm/java-17-openjdk-amd64
KS="$T/keys/upload.jks"; mkdir -p "$T/keys"; chmod 750 "$T/keys"
"$JDK/bin/keytool" -genkeypair -keystore "$KS" -storepass pw123456 -keypass pw123456 -alias upload \
  -dname CN=test -keyalg RSA -keysize 2048 -validity 2 >/dev/null 2>"$T/kt" || { echo "keytool failed: $(cat "$T/kt")"; exit 1; }
chmod 640 "$KS"

mk() {  # mk [tag]: fresh worktree repo in $W on master, optionally tagged
  W="$T/wt"; if [ -d "$W" ]; then chmod -R u+rwx "$W"; rm -rf "$W"; fi; mkdir -p "$W/app"
  cp "$canon/build-examples/android-gradle/build_app" "$canon/build-examples/android-gradle/android-build-info" "$canon/perm-lib.sh" "$canon/perm-engine.py" "$canon/perm-model.tsv" "$W/"
  cat >"$W/ve-resolve-orch" <<'S'
ve_resolve_orch() { ORCH_ROOT="$1"; }
ve_setup_worktree_build_homes() { mkdir -p "$1/.gradle-home"; export GRADLE_USER_HOME="$1/.gradle-home"; }
ve_aapt2_from_sdk() { echo /bin/true; }
ve_reset_gradle_daemon_dir() { return 0; }
ve_wipe_foreign_app_build_outputs() { return 0; }
S
  cat >"$W/gradlew" <<G
#!/bin/bash
set -e
printf '%s\n' "\$*" >>"$T/gradle-calls"
[ -f "$T/fail-stop" ] && [[ " \$* " == *" --stop "* ]] && { echo "stand-in gradle: stop failed" >&2; exit 1; }
[ -f "$T/fail-gradle" ] && { echo "stand-in gradle: forced failure" >&2; exit 1; }
for a in "\$@"; do
  case "\$a" in
    bundleRelease)
      d=app/build/outputs/bundle/release; mkdir -p "\$d"
      git describe --always >"$T/versionName-at-build"
      cat app/versionCode.txt >"$T/versionCode-at-build"
      python3 - "\$d/app-release.aab" <<'PY'
import os, subprocess, sys, zipfile
p = sys.argv[1]
with zipfile.ZipFile(p, "w") as z:
    z.writestr("base/manifest/AndroidManifest.xml", "x")
e = os.environ
pre = "ORG_GRADLE_PROJECT_android.injected.signing."
subprocess.run(["$JDK/bin/jarsigner", "-keystore", e[pre + "store.file"], "-storepass", e[pre + "store.password"],
                "-keypass", e[pre + "key.password"], p, e[pre + "key.alias"]], check=True, stdout=subprocess.DEVNULL)
PY
      ;;
  esac
done
G
  chmod 755 "$W/gradlew"
  cat >"$W/project.config" <<C
primary_user=nobody
coder_user=$me
planning_user=ai-planner
java_home=$JDK
code_group=ai-code
shared_group=ai-shared
sandbox_group=ai-sandbox
release_keystore=$KS
release_key_alias=upload
release_bundle_task=bundleRelease
release_bundle_path=app/build/outputs/bundle/release/app-release.aab
C
  echo 1 >"$W/app/versionCode.txt"
  printf '%s\n' '## Build and commit' '- **Standard build:** debug' '- **Test build:** none' >"$W/project-facts.md"
  printf 'project.config\n.gradle-home/\napp/build/\n' >"$W/.gitignore"
  ln -s app/build/outputs/bundle/release/app-release.aab "$W/play-bundle.aab"   # tracked, dangling until --play
  git -C "$W" init -q -b master && git -C "$W" add -A && git -C "$W" -c user.name=t -c user.email=t@t commit -qm init
  if [ -n "${1:-}" ]; then git -C "$W" -c user.name=t -c user.email=t@t tag -a "$1" -m "$1"; fi
}
play() {  # play ANSWERS: run ./build_app --play in a pty, typing ANSWERS
  printf "$1" | (cd "$W" && GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t \
    script -qec "./build_app --play" /dev/null) >"$T/out" 2>&1
}
vc() { tr -d '[:space:]' <"$W/app/versionCode.txt"; }

mk v0.9
play 'pw123456\n\n'; rc=$?
[[ $rc -eq 0 ]] && ok "--play rc 0" || bad "--play rc=$rc: $(tail -15 "$T/out")"
[[ "$(vc)" == 2 ]] && ok "versionCode 1 -> 2" || bad "versionCode $(vc)"
[[ "$(git -C "$W" log -1 --format=%s)" == "versionCode 2 (next play build)" && "$(git -C "$W" log -1 --format=%s HEAD~1)" == init ]] && ok "bump committed on its own, after the built commit" || bad "HEAD subject: $(git -C "$W" log -1 --format=%s)"
[[ "$(git -C "$W" show --stat --format= HEAD | grep -c '|')" == 1 ]] && ok "bump commit touches only app/versionCode.txt" || bad "bump commit files: $(git -C "$W" show --stat --format= HEAD)"
[[ -z "$(git -C "$W" tag -l '*+*')" ]] && ok "--play creates no version tag" || bad "tags: $(git -C "$W" tag | tr '\n' ' ')"
[[ "$(cat "$T/versionName-at-build")" == "$(git -C "$W" describe --always HEAD~1)" && "$(cat "$T/versionCode-at-build")" == 1 ]] && grep -q "Commit:      $(git -C "$W" rev-parse HEAD~1)" "$T/out" && grep -q 'versionCode: 1' "$T/out" && ok "gradle built the pre-bump commit with versionCode 1; summary names it" || bad "at build: $(cat "$T/versionName-at-build") $(cat "$T/versionCode-at-build")"
grep -q 'TESTING' "$T/out" && bad "release build asked the testing question" || ok "no testing-version prompt on a release"
grep -q 'Tag:' "$T/out" && bad "summary still names a tag" || ok "summary names no tag"
[[ "$(stat -c %a "$W/app/build/outputs/bundle/release/app-release.aab")" == 644 ]] && ok "AAB is 644" || bad "AAB mode $(stat -c %a "$W/app/build/outputs/bundle/release/app-release.aab")"
[[ "$(git -C "$W" rev-parse builds)" == "$(git -C "$W" rev-parse HEAD~1)" ]] && ok "builds tag on the built commit, not the bump" || bad "builds tag"
play 'pw123456\n\n'; rc=$?
[[ $rc -eq 0 && "$(vc)" == 3 && "$(cat "$T/versionCode-at-build")" == 2 && -z "$(git -C "$W" tag -l '*+*')" ]] && ok "second --play builds code 2, bumps to 3, no version tag" || bad "second play rc=$rc vc=$(vc) tags=$(git -C "$W" tag | tr '\n' ' ')"

mk
play 'pw123456\n\n'; rc=$?
[[ $rc -eq 0 && "$(vc)" == 2 && -z "$(git -C "$W" tag -l '*+*')" ]] && ok "untagged repo: --play works, no tag" || bad "untagged repo rc=$rc tags=$(git -C "$W" tag | tr '\n' ' ') $(tail -5 "$T/out")"

# One daemon per run, private registry, stopped at exit (success, failure, stop failure).
mk v6.0; rm -f "$T/gradle-calls"
play 'pw123456\n\n'; rc=$?
reg=$(grep -o 'registry.base=[^ ]*' "$T/gradle-calls" | sort -u)
[[ $rc -eq 0 && $(echo "$reg" | wc -l) == 1 && "$reg" == "registry.base=$W/.gradle-home/daemon-run."* ]] && ok "every gradle call uses one private daemon registry" || bad "registry: rc=$rc '$reg'"
! grep -q -- '--no-daemon' "$T/gradle-calls" && grep -q -- '--daemon' "$T/gradle-calls" && ok "gradle runs with --daemon, never --no-daemon" || bad "flags: $(cat "$T/gradle-calls")"
mk v6.0; rm -f "$T/gradle-calls"; mkdir -p "$W/.gradle-home"
cat >"$W/gradlew.real" <"$W/gradlew"; cat >"$W/gradlew" <<'G'
#!/bin/bash
r=$(printf '%s\n' "$@" | sed -n 's/^-Dorg.gradle.daemon.registry.base=//p'); mkdir -p "$r/9.1"; : >"$r/9.1/registry.bin"
exec "$(dirname "$0")/gradlew.real" "$@"
G
chmod 755 "$W/gradlew" "$W/gradlew.real"; git -C "$W" add -A; git -C "$W" -c user.name=t -c user.email=t@t commit -qm wrap
play 'pw123456\n\n'; rc=$?
[[ $rc -eq 0 && "$(tail -1 "$T/gradle-calls")" == *--stop* ]] && grep -q "Gradle daemon stopped" "$T/out" && [[ -z "$(ls -d "$W"/.gradle-home/daemon-run.* 2>&1 | grep -v 'No such')" ]] && ok "success: --stop is the last gradle call, registry removed" || bad "stop: rc=$rc $(tail -2 "$T/gradle-calls") $(tail -3 "$T/out")"
touch "$T/fail-stop"; play 'pw123456\n\n'; rc=$?; rm -f "$T/fail-stop"
[[ $rc -ne 0 ]] && grep -q "could not stop this run's Gradle daemon" "$T/out" && ok "a failing --stop after a good build exits non-zero" || bad "stopfail: rc=$rc $(tail -3 "$T/out")"
touch "$T/fail-stop" "$T/fail-gradle"; rm -f "$T/gradle-calls"; play 'pw123456\n\n'; rc=$?; rm -f "$T/fail-stop" "$T/fail-gradle"
[[ $rc -eq 1 && "$(tail -1 "$T/gradle-calls")" == *--stop* ]] && grep -q 'Build failed' "$T/out" && grep -q 'the build had already failed, exit 1' "$T/out" && ok "failed build + failing --stop: both reported, build's exit kept" || bad "both: rc=$rc $(tail -4 "$T/out")"

mk v1.0; touch "$T/fail-gradle"
play 'pw123456\n\n'; rc=$?; rm -f "$T/fail-gradle"
[[ $rc -ne 0 ]] && ok "failing gradle fails --play" || bad "gradle failure rc=$rc"
[[ "$(vc)" == 1 && "$(git -C "$W" log -1 --format=%s)" == init ]] && ok "failed build: no bump, nothing committed" || bad "after failure: vc=$(vc) $(tail -4 "$T/out")"

mk v1.0; git -C "$W" checkout -q -b feat; git -C "$W" tag feat-start
play 'n\n'; rc=$?
[[ $rc -ne 0 && "$(vc)" == 1 ]] && grep -q 'nothing built or committed' "$T/out" && [[ "$(git -C "$W" log -1 --format=%s)" == init ]] && ok "BRANCH-start branch: answering N aborts before any bump" || bad "testing abort rc=$rc vc=$(vc) $(tail -4 "$T/out")"

mk; git -C "$W" rm -q app/versionCode.txt; git -C "$W" -c user.name=t -c user.email=t@t commit -qm rm
play 'pw123456\n\n'; rc=$?
[[ $rc -ne 0 ]] && grep -q -- '--play needs app/versionCode.txt' "$T/out" && ok "missing versionCode.txt is an error" || bad "missing vc rc=$rc $(tail -3 "$T/out")"


# play-bundle.aab: tracked relative symlink, checked (never written) by build_app.
mk v5.0
play 'pw123456\n\n'; rc=$?
[[ $rc -eq 0 && -r "$W/play-bundle.aab" && -z "$(git -C "$W" status --porcelain)" ]] && ! grep -q 'play-bundle' "$W/.git/info/exclude" \
  && grep -q "Link:        $W/play-bundle.aab" "$T/out" && ok "--play: tracked link resolves to the new bundle, tree clean, nothing excluded" || bad "link: rc=$rc $(git -C "$W" status --porcelain) $(tail -5 "$T/out")"
mk v5.0; git -C "$W" rm -q play-bundle.aab; git -C "$W" -c user.name=t -c user.email=t@t commit -qm rmlink
play 'pw123456\n\n'; rc=$?
[[ $rc -ne 0 && "$(vc)" == 1 ]] && grep -q 'play-bundle.aab is not tracked' "$T/out" && grep -q "ln -sfn 'app/build/outputs/bundle/release/app-release.aab' play-bundle.aab" "$T/out" \
  && ok "missing link: error with the fix, before the versionCode bump" || bad "nolink: rc=$rc vc=$(vc) $(tail -4 "$T/out")"
mk v5.0; ln -sfn app/build/other.aab "$W/play-bundle.aab"; git -C "$W" -c user.name=t -c user.email=t@t commit -qam wrong
play 'pw123456\n\n'; rc=$?
[[ $rc -ne 0 && "$(vc)" == 1 ]] && grep -q "points at 'app/build/other.aab', not release_bundle_path" "$T/out" && ok "link to the wrong path: error before the bump" || bad "wrong: rc=$rc $(tail -4 "$T/out")"
mk v5.0; rm "$W/play-bundle.aab"; echo x >"$W/play-bundle.aab"; git -C "$W" -c user.name=t -c user.email=t@t commit -qam file
play 'pw123456\n\n'; rc=$?
[[ $rc -ne 0 ]] && grep -q 'is not a symlink (git mode 100644)' "$T/out" && ok "tracked regular file instead of a link: error" || bad "file: rc=$rc $(tail -3 "$T/out")"

# Multi-user mode: every mode re-executes as coder_user (sudo -n -u, invoker's git identity
# carried) before anything else; a recording sudo shim stands in for sudo.
mkdir -p "$T/sudoshim"; printf '#!/bin/sh\nprintf "%%s\\n" "$*" >"%s/sudo-args"\nexit 0\n' "$T" >"$T/sudoshim/sudo"; chmod 755 "$T/sudoshim/sudo"
for m in "--play" "--standard --test" "" "--play --standard"; do
  mk v4.0; sed -i 's/^coder_user=.*/coder_user=ai-coder-test/' "$W/project.config"; rm -f "$T/sudo-args"
  (cd "$W" && git config user.name 'Inv Oker' && git config user.email inv@ex && PATH="$T/sudoshim:$PATH" ./build_app $m </dev/null) >"$T/out" 2>&1; rc=$?
  a=$(cat "$T/sudo-args" 2>&1)
  [[ $rc -eq 0 && "$a" == "-n -u ai-coder-test /usr/bin/env GIT_AUTHOR_NAME=Inv Oker GIT_AUTHOR_EMAIL=inv@ex GIT_COMMITTER_NAME=Inv Oker GIT_COMMITTER_EMAIL=inv@ex BUILD_APP_INVOKER=$me ./build_app${m:+ $m}" ]] \
    && [[ "$(vc)" == 1 && "$(git -C "$W" log -1 --format=%s)" == init ]] \
    && ok "re-exec as coder_user before any work: './build_app${m:+ $m}'" || bad "re-exec '$m': rc=$rc args='$a' $(tail -3 "$T/out")"
done

# Single-user mode (no project.config): Play signing only from explicit options.
playargs() {  # playargs ANSWERS ARGS...: ./build_app --play ARGS in a pty
  local a="$1"; shift
  printf "$a" | (cd "$W" && GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t \
    script -qec "./build_app --play $*" /dev/null) >"$T/out" 2>&1
}
SC="$T/signing.conf"
printf '# signing\nrelease_keystore=%s\nrelease_key_alias=upload\nrelease_bundle_task=bundleRelease\nrelease_bundle_path=app/build/outputs/bundle/release/app-release.aab\n' "$KS" >"$SC"
mk v3.0; rm "$W/project.config"
playargs 'pw123456\n\n' --signing-config "$SC"; rc=$?
[[ $rc -eq 0 && "$(vc)" == 2 ]] && grep -q 'NOTICE: single-user mode' "$T/out" && [[ -z "$(git -C "$W" tag -l '*+*')" ]] && ok "single-user --play with --signing-config builds, no version tag" || bad "su signing-config rc=$rc $(tail -8 "$T/out")"
mk v3.0; rm "$W/project.config"
playargs 'pw123456\n\n' --release-keystore "$KS" --release-key-alias upload --release-bundle-task bundleRelease --release-bundle-path app/build/outputs/bundle/release/app-release.aab; rc=$?
[[ $rc -eq 0 && "$(vc)" == 2 ]] && ok "single-user --play with individual flags" || bad "su flags rc=$rc $(tail -8 "$T/out")"
mk v3.0; rm "$W/project.config"
playargs 'pw123456\n\n' --release-keystore "$KS" --release-key-alias upload; rc=$?
[[ $rc -ne 0 && "$(vc)" == 1 ]] && grep -q 'signing keys were not given: release_bundle_task release_bundle_path' "$T/out" && ok "single-user: missing keys named, nothing committed" || bad "su missing rc=$rc $(tail -4 "$T/out")"
mk v3.0; rm "$W/project.config"; cp "$KS" "$T/keys/other.jks"
playargs 'pw123456\n\n' --signing-config "$SC" --release-keystore "$T/keys/other.jks"; rc=$?
[[ $rc -ne 0 && "$(vc)" == 1 ]] && grep -q 'release_keystore given twice' "$T/out" && ok "key from file and flag: error" || bad "su twice rc=$rc $(tail -4 "$T/out")"
printf 'release_keystore=%s\nsecret=x\n' "$KS" >"$T/bad.conf"
mk v3.0; rm "$W/project.config"
playargs 'pw123456\n\n' --signing-config "$T/bad.conf"; rc=$?
[[ $rc -ne 0 ]] && grep -q "line 2: unknown key 'secret'" "$T/out" && ok "unknown key in signing config: error" || bad "su unknown rc=$rc $(tail -4 "$T/out")"
mk v3.0; rm "$W/project.config"
playargs 'pw123456\n\n' --signing-config "$T/nope.conf"; rc=$?
[[ $rc -ne 0 ]] && grep -q 'nope.conf: not a readable file' "$T/out" && ok "missing signing config file: error" || bad "su nofile rc=$rc"
mk v3.0
playargs 'pw123456\n\n' --signing-config "$SC"; rc=$?
[[ $rc -ne 0 && "$(vc)" == 1 ]] && grep -q 'this worktree has a project.config' "$T/out" && ok "with project.config: explicit signing options refused (config behaviour kept)" || bad "mu refuse rc=$rc $(tail -4 "$T/out")"
mk v3.0; rm "$W/project.config"
(cd "$W" && ./build_app --standard --signing-config "$SC" </dev/null) >"$T/out" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q 'given without --play' "$T/out" && ok "signing options without --play: error" || bad "noplay rc=$rc $(tail -3 "$T/out")"

mk v5.0; git -C "$W" rm -q play-bundle.aab; git -C "$W" -c user.name=t -c user.email=t@t commit -qm rmlink; rm "$W/project.config"
playargs 'pw123456\n\n' --signing-config "$SC"; rc=$?
[[ $rc -ne 0 ]] && grep -q 'play-bundle.aab is not tracked' "$T/out" && ok "single-user --play without the link: same error" || bad "su nolink: rc=$rc $(tail -3 "$T/out")"

echo "passed $pass failed $fail"
[[ $fail -eq 0 ]]
