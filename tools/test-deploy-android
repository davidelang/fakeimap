#!/usr/bin/env bash
# No-device tests of build-examples/android-gradle/deploy: fake adb and fake SDK aapt2 on a scratch
# git repo (no real device, tag or APK is touched). APKs come from fake output-metadata.json
# recorded by android-build-info. Covers the app-id path, --test androidTest install
# (adb install -r -t, verified, tag only on success), the --test refusals and single-user mode.
set -uo pipefail
C=$(git rev-parse --show-toplevel)
T=$(mktemp -d /tmp/test-deploy-android.XXXXXX); trap 'rm -rf "$T"' EXIT
pass=0 fail=0; ok(){ pass=$((pass+1)); echo "ok   $*"; }; bad(){ fail=$((fail+1)); echo "FAIL $*"; }
R=$T/repo; mkdir -p $R $T/bin $T/sdk/build-tools/99.0.0
cp $C/build-examples/android-gradle/deploy $C/build-examples/android-gradle/android-build-info $C/ve-resolve-orch $R/
echo "sdk.dir=$T/sdk" > $R/local.properties
A=app/build/outputs/apk
TA=$A/androidTest/x86_64/debug/app-x86_64-debug-androidTest.apk
meta() {  # meta DIR VARIANT APPID APK: fake gradle output (output-metadata.json + APK)
  mkdir -p $R/$A/$1; echo "$2" >$R/$A/$1/$4
  printf '{"version":3,"artifactType":{"type":"APK","kind":"Directory"},"applicationId":"%s","variantName":"%s","elements":[{"type":"SINGLE","filters":[],"versionName":"1.0","outputFile":"%s"}]}\n' "$3" "$2" "$4" >$R/$A/$1/output-metadata.json
}
meta arm64/debug arm64Debug com.example.app app-arm64-debug.apk
meta x86_64/debug x86_64Debug com.example.app app-x86_64-debug.apk
meta androidTest/x86_64/debug x86_64DebugAndroidTest com.example.app.test app-x86_64-debug-androidTest.apk
cat > $R/project.config <<C
primary_user=$(id -un)
planning_user=ai-planner
coder_user=ai-coder
C
printf '%s\n' '## Build and commit' '- **Standard build:** debug' '- **Test build:** instrumentation:x86_64Debug' >$R/project-facts.md
printf 'app/build/\nproject.config\n' >$R/.gitignore
git -C $R init -q; git -C $R add project-facts.md .gitignore; git -C $R -c user.name=t -c user.email=t@t commit -q -m init
stamp() { (cd $R && ./android-build-info stamp standard && ./android-build-info stamp test) >$T/stamp 2>&1 || { echo "stamp failed: $(cat $T/stamp)"; exit 1; }; }
stamp
cat > $T/sdk/build-tools/99.0.0/aapt2 <<'B'
#!/bin/sh
f="$3"
case "$f" in
  *androidTest*) [ -n "${A_TEST_FAIL:-}" ] && { echo "error: failed opening zip" >&2; exit 1; }; pkg="${A_TEST:-com.example.app.test}"; abi="" ;;
  *arm64*) pkg=com.example.app; abi="'arm64-v8a'" ;;
  *) pkg=com.example.app; abi="'x86_64'" ;;
esac
case "$2" in
  packagename) echo "$pkg" ;;
  badging) echo "package: name='$pkg' versionCode='1' versionName='1.0'"; [ -n "$abi" ] && echo "native-code: $abi" ;;
esac
exit 0
B
chmod +x $T/sdk/build-tools/99.0.0/aapt2
cat > $T/bin/adb <<'X'
#!/usr/bin/env bash
echo "adb $*" >>"$FAKE/calls"
[ "$1" = -s ] && shift 2
case "$1" in
  devices) printf 'List of devices attached\nemulator-5554\tdevice\n' ;;
  shell) case "$2" in
      getprop) echo x86_64 ;;
      pm) grep -F -- "$5" "$FAKE/installed" | sed 's/^/package:/' ;;
    esac ;;
  install) f="${@: -1}"
     case "$f" in
       *androidTest*) [ -n "${ADB_TEST_FAIL:-}" ] && { echo Failure; exit 1; }
                      [ -z "${ADB_TEST_NOREG:-}" ] && echo "${A_TEST:-com.example.app.test}" >>"$FAKE/installed" ;;
       *) echo com.example.app >>"$FAKE/installed" ;;
     esac; echo Success ;;
  logcat) ;;
esac
X
chmod +x $T/bin/adb
export FAKE=$T PATH=$T/bin:$PATH
run() { (cd $R && ./deploy "$@") >$T/out 2>&1; rc=$?; }
reset() { : >$T/calls; : >$T/installed; unset A_TEST A_TEST_FAIL ADB_TEST_FAIL ADB_TEST_NOREG; git -C $R tag -d deployed deployed-test >/dev/null 2>&1; }
tag() { git -C $R rev-parse -q --verify "$1" >/dev/null; }

reset; run emulator
[[ $rc -eq 0 ]] && ! grep -q 'install -r -t' $T/calls && ! grep -q androidTest $T/calls \
  && grep -q 'install -r .*x86_64-debug.apk' $T/calls && tag deployed && ok "default: standard app installed, androidTest not, deployed tag" || bad "default: rc=$rc $(cat $T/out)"

reset; run --test emulator
[[ $rc -eq 0 ]] && grep -q "install -r -t $TA" $T/calls && grep -qx com.example.app.test $T/installed && grep -q 'Installed androidTest com.example.app.test' $T/out \
  && tag deployed-test && ok "--test: androidTest installed with -r -t, verified, deployed-test tag" || bad "--test: rc=$rc $(cat $T/out) $(cat $T/calls)"
grep -n 'install' $T/calls | head -1 | grep -q 'x86_64-debug.apk' && ok "--test: app installed before the test APK" || bad "order: $(cat $T/calls)"

reset; mv $R/app/build/outputs/build_app/test.json $T/test.json; run --test emulator
[[ $rc -ne 0 ]] && grep -q 'no test build recorded' $T/out && ! grep -q adb $T/calls && ! tag deployed-test && ok "--test: no test build fails before adb, no standard fallback" || bad "no test: rc=$rc $(cat $T/out)"
mv $T/test.json $R/app/build/outputs/build_app/test.json

reset; mv $R/$TA $T/ta; run --test emulator
[[ $rc -ne 0 ]] && grep -q 'app-x86_64-debug-androidTest.apk (recorded by the test build) is missing' $T/out && ! grep -q adb $T/calls && ! tag deployed-test && ok "--test: missing androidTest APK fails before adb, no tag" || bad "missing: rc=$rc $(cat $T/out)"
mv $T/ta $R/$TA

reset; git -C $R -c user.name=t -c user.email=t@t commit -q --allow-empty -m newer; run --test emulator
[[ $rc -ne 0 ]] && grep -q 'not HEAD' $T/out && ! grep -q adb $T/calls && ok "--test: test build older than HEAD refused" || bad "stale: rc=$rc $(cat $T/out)"
stamp

reset; A_TEST_FAIL=1 run --test emulator
[[ $rc -ne 0 ]] && grep -q 'dump packagename .*androidTest.* failed' $T/out && ! grep -q adb $T/calls && ! tag deployed-test && ok "--test: unreadable androidTest APK fails before adb" || bad "unreadable: rc=$rc $(cat $T/out)"

reset; ADB_TEST_FAIL=1 run --test emulator
[[ $rc -ne 0 ]] && grep -q 'adb install -r -t .* failed' $T/out && ! tag deployed-test && ok "--test: failed test install fails, no tag" || bad "install fail: rc=$rc $(cat $T/out)"

reset; ADB_TEST_NOREG=1 run --test emulator
[[ $rc -ne 0 ]] && grep -q 'com.example.app.test is not installed' $T/out && ! tag deployed-test && ok "--test: test package not in pm list fails, no tag" || bad "noreg: rc=$rc $(cat $T/out)"

reset; A_TEST=com.example.app run --test emulator
[[ $rc -ne 0 ]] && grep -q "has the app's own id" $T/out && ! grep -q adb $T/calls && ok "--test: androidTest APK with the app's id rejected" || bad "same id: rc=$rc $(cat $T/out)"

reset; mv $R/project.config $T/pc; run emulator
[[ $rc -eq 0 ]] && grep -q 'NOTICE: single-user mode: no project.config' $T/out && tag deployed && ok "single-user: no project.config deploys, says why" || bad "single-user: rc=$rc $(cat $T/out)"
reset; printf 'primary_user=@@PRIMARY_USER@@\n' >$R/project.config; run emulator
[[ $rc -eq 0 ]] && grep -q 'unsmudged @@TOKEN@@' $T/out && ok "single-user: unsmudged project.config" || bad "smudge: rc=$rc $(cat $T/out)"
mv $T/pc $R/project.config

reset; mv $R/local.properties $T/lp; (unset ANDROID_HOME; cd $R && ./deploy emulator) >$T/out 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q 'sdk.dir is not set in .*local.properties and ANDROID_HOME is not set' $T/out && ok "no SDK: error names sdk.dir and ANDROID_HOME" || bad "nosdk: rc=$rc $(cat $T/out)"
reset; (export ANDROID_HOME=$T/sdk; cd $R && ./deploy emulator) >$T/out 2>&1; rc=$?
[[ $rc -eq 0 ]] && ok "SDK from ANDROID_HOME" || bad "android_home: rc=$rc $(cat $T/out)"
mv $T/lp $R/local.properties

reset; run -h
[[ $rc -eq 0 ]] && grep -q -- '-c, --clean' $T/out && ! grep -q adb $T/calls && ok "deploy -h exits 0 and does not install" || bad "help rc=$rc $(tail -3 $T/out)"
reset; run tablet --clean
[[ $rc -eq 0 ]] && grep -q 'nothing to uninstall' $T/out && grep -q 'install -r' $T/calls && ok "tablet --clean uninstalls before install" || bad "clean rc=$rc $(tail -5 $T/out) $(cat $T/calls)"
reset; run -c tablet
[[ $rc -eq 0 ]] && grep -q 'nothing to uninstall' $T/out && ok "-c is --clean" || bad "short clean rc=$rc $(tail -4 $T/out)"
grep -qE '\|\| true|2>/dev/null' $C/build-examples/android-gradle/deploy && bad "deploy swallows errors" || ok "deploy: no '|| true', no '2>/dev/null'"
echo "passed $pass failed $fail"; [[ $fail -eq 0 ]]
