#!/usr/bin/env python3
"""Class master: payload stays in the template, is removed from a host's orchestration
branch, and is published onto every other branch. Master may advance or be rewritten
after a fork. The template itself has no master branch."""
import os, shutil, subprocess, sys

def scratch_dir(name):
    import atexit
    p = subprocess.run([os.path.join(os.path.dirname(os.path.abspath(__file__)), "scratch-dir"), name],
                       capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(p.stderr.strip() or "scratch-dir failed")
    os.environ["GIT_CEILING_DIRECTORIES"] = os.path.dirname(p.stdout.strip())
    atexit.register(shutil.rmtree, p.stdout.strip())
    return p.stdout.strip()

canon_src = subprocess.run(["git", "-c", "safe.directory=*", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip()
passed = failed = 0
def check(cond, m):
    global passed, failed
    if cond:
        passed += 1
        print("ok   " + m)
    else:
        failed += 1
        print("FAIL " + m)

def sh(cwd, *a, check=True):
    p = subprocess.run(list(a), cwd=cwd, capture_output=True, text=True)
    if check and p.returncode:
        raise RuntimeError("%s: %s" % (a, p.stderr))
    return p
def g(cwd, *a):
    return sh(cwd, "git", *a).stdout.strip()
def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)
    os.chmod(path, mode)
def commit(repo, msg):
    g(repo, "add", "-A")
    g(repo, "commit", "-q", "-m", msg)

home = scratch_dir("test-deploy-master-class")
os.environ.update(GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
canon = os.path.join(home, "orchestration-example")
os.makedirs(canon + "/orch")
shutil.copy2(os.path.join(canon_src, "deploy-orchestration"), canon + "/deploy-orchestration")
shutil.copy2(os.path.join(canon_src, "orch/perm-engine.py"), canon + "/orch/perm-engine.py")
shutil.copy2(os.path.join(canon_src, "orch/perm-model.tsv"), canon + "/orch/perm-model.tsv")
g(canon, "init", "-q", "-b", "template")
write(canon + "/rules.manifest", "shared AGENTS.md\nmaster block.txt\n")
write(canon + "/AGENTS.md", "agents\n")
write(canon + "/update-rules.sh", "#\n", 0o755)
write(canon + "/block.txt", "the block\n")
write(canon + "/project.config", "git_home=%s\n" % home)
write(canon + "/.gitignore", "project.config\n")
commit(canon, "template")
check(g(canon, "branch", "--list", "master") == "", "template has no master branch")

host = os.path.join(home, "app")
os.makedirs(host)
g(host, "init", "-q", "-b", "orchestration")
write(host + "/AGENTS.md", "agents\n")
write(host + "/update-rules.sh", "#\n", 0o755)
write(host + "/rules.manifest", "shared AGENTS.md\n")
write(host + "/rules.manifest.local", "local .gitignore\n")
write(host + "/.gitignore", "project.config\n/master/\n/agent-1/\n")
write(host + "/project.config", "x=1\n")
write(host + "/block.txt", "cloned onto orchestration\n")
commit(host, "orchestration has the block")
g(host, "checkout", "-q", "--orphan", "master")
g(host, "rm", "-q", "-rf", ".")
g(host, "commit", "-q", "--allow-empty", "-m", "empty master")
g(host, "checkout", "-q", "orchestration")
g(host, "worktree", "add", "-q", os.path.join(host, "master"), "master")
g(host, "worktree", "add", "-q", "-b", "feature", os.path.join(host, "agent-1"), "master")

r = sh(canon, sys.executable, "./deploy-orchestration", "--apply", "--repos", "app", check=False)
check(r.returncode == 0, "apply exits 0 (%s)" % r.stdout[-400:].replace("\n", " | "))
check(not os.path.exists(host + "/block.txt"), "orchestration branch loses block.txt")
check(open(host + "/master/block.txt").read() == "the block\n", "empty master receives the template block")
check(open(host + "/agent-1/block.txt").read() == "the block\n", "branch forked from master receives the block")
check("block.txt" not in g(host, "ls-files"), "orchestration commit no longer tracks block.txt")
check(g(host + "/master", "rev-parse", "--abbrev-ref", "HEAD") == "master", "master worktree stays on master")

# Master moves, then an unrelated branch is rewritten with no shared history.
write(host + "/master/app.txt", "advanced\n")
commit(host + "/master", "master advances")
g(host, "checkout", "-q", "--orphan", "rewritten")
g(host, "rm", "-q", "-rf", ".")
g(host, "commit", "-q", "--allow-empty", "-m", "rewritten history")
g(host, "checkout", "-q", "orchestration")
g(host, "worktree", "add", "-q", os.path.join(home, "rewritten"), "rewritten")
anc = sh(host, "git", "merge-base", "--is-ancestor", "master", "rewritten", check=False)
check(anc.returncode != 0, "rewritten history does not contain master")

r = sh(canon, sys.executable, "./deploy-orchestration", "--apply", "--repos", "app", check=False)
check(r.returncode == 0, "apply after rewrite exits 0 (%s)" % r.stdout[-400:].replace("\n", " | "))
check(not os.path.exists(host + "/block.txt"), "orchestration still has no block.txt")
check(open(os.path.join(home, "rewritten", "block.txt")).read() == "the block\n",
      "rewritten branch with no master ancestor receives the block")
check(open(host + "/master/block.txt").read() == "the block\n", "advanced master keeps the block")

r = sh(canon, sys.executable, "./deploy-orchestration", "--apply", "--repos", "app", check=False)
check(r.returncode == 0 and "WOULD-COMMIT" not in r.stdout and "COMMITTED" not in r.stdout,
      "rerun is up-to-date")
print("%d passed, %d failed" % (passed, failed))
sys.exit(1 if failed else 0)
