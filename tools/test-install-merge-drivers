#!/usr/bin/env bash
# install-merge-drivers.sh: sets canon git config; runs the optional project-owned
# install-merge-drivers.local and fails when it fails; -h and unknown-option behavior.
# Runs the real script in scratch git repos built from canon's files.
set -uo pipefail
canon="$(git rev-parse --show-toplevel)"
T="$("$(dirname "$0")/scratch-dir" install-merge-drivers-test)" || exit 1
export GIT_CEILING_DIRECTORIES="$(dirname "$T")"; trap 'rm -rf "$T"' EXIT
pass=0 fail=0
ok()  { pass=$((pass+1)); echo "ok   $*"; }
bad() { fail=$((fail+1)); echo "FAIL $*"; }
mkrepo() {
  local r="$T/$1"; mkdir -p "$r/git-merge-drivers" "$r/orch"
  git init -q "$r" || return 1
  cp "$canon/orch/install-merge-drivers.sh" "$canon/orch/merge-branch-into-master.sh" "$r/orch/"
  cp "$canon"/git-merge-drivers/ve-englog "$canon"/git-merge-drivers/ve-special-ours "$canon"/git-merge-drivers/ve-special-refuse "$canon"/git-merge-drivers/ve-versioncode "$r/git-merge-drivers/"
  echo "$r"
}
cfg() { git -C "$1" config --local --get "$2"; }

r=$(mkrepo plain) || exit 1
(cd "$r" && bash ./orch/install-merge-drivers.sh) >"$T/plain.out" 2>&1; rc=$?
[[ $rc -eq 0 ]] && ok "plain: exit 0" || bad "plain: rc=$rc $(cat "$T/plain.out")"
[[ "$(cfg "$r" filter.manage-configs.required)" == true ]] && ok "plain: manage-configs required" || bad "plain: manage-configs.required"
[[ "$(cfg "$r" filter.json-pretty.clean)" == "python3 ./orch/json-pretty-filter clean" ]] && ok "plain: json-pretty clean" || bad "plain: json-pretty clean"
[[ "$(cfg "$r" filter.json-pretty.required)" == true ]] && ok "plain: json-pretty required" || bad "plain: json-pretty required"
[[ -z "$(cfg "$r" filter.json-pretty.smudge)" ]] && ok "plain: json-pretty has no smudge" || bad "plain: json-pretty smudge is set"
[[ "$(cfg "$r" merge.ve-englog.driver)" == "./git-merge-drivers/ve-englog %O %A %B %L %P" ]] && ok "plain: ve-englog driver" || bad "plain: ve-englog driver"
[[ "$(cfg "$r" merge.ve-versioncode.driver)" == "./git-merge-drivers/ve-versioncode %O %A %B %L %P" ]] && ok "plain: ve-versioncode driver" || bad "plain: ve-versioncode driver"
rel=$(git -C "$r" rev-parse --git-path info/attributes)
case "$rel" in /*) attr="$rel" ;; *) attr="$r/$rel" ;; esac
grep -qxF 'app/versionCode.txt merge=ve-versioncode' "$attr" && ok "plain: info/attributes binds versionCode" || bad "plain: info/attributes missing ($attr)"
grep -qxF '*.json filter=json-pretty' "$attr" && ok "plain: info/attributes json-pretty" || bad "plain: info/attributes json"
grep -qxF 'docs/i18n/** filter=lfs diff=lfs merge=lfs -text' "$attr" && ok "plain: info/attributes i18n lfs" || bad "plain: info/attributes lfs"
grep -qxF 'docs/i18n/**/user-manual.md !filter !diff !merge text' "$attr" && ok "plain: info/attributes manuals are text" || bad "plain: info/attributes manuals"
grep -qxF 'app/src/main/i18n/** filter=lfs diff=lfs merge=lfs -text' "$attr" && ok "plain: info/attributes app i18n lfs" || bad "plain: info/attributes app i18n"
relx=$(git -C "$r" rev-parse --git-path info/exclude)
case "$relx" in /*) exc="$relx" ;; *) exc="$r/$relx" ;; esac
grep -qxF 'app/src/main/res/values/strings.xml' "$exc" && grep -qxF 'app/src/main/res/values-*/strings.xml' "$exc" && ok "plain: info/exclude generated strings" || bad "plain: info/exclude ($exc)"
git -C "$r" config filter.json-pretty.smudge cat
(cd "$r" && bash ./orch/install-merge-drivers.sh) >/dev/null 2>&1
[[ -z "$(cfg "$r" filter.json-pretty.smudge)" ]] && ok "plain: existing smudge is removed" || bad "plain: smudge survived"
[[ "$(grep -cxF 'app/versionCode.txt merge=ve-versioncode' "$attr")" == 1 ]] && ok "plain: second install does not duplicate the attribute" || bad "plain: attribute duplicated"
[[ "$(grep -cxF '*.json filter=json-pretty' "$attr")" == 1 ]] && ok "plain: second install does not duplicate json-pretty" || bad "plain: json-pretty duplicated"
[[ "$(cfg "$r" merge.autostash)" == false ]] && ok "plain: merge.autostash=false" || bad "plain: autostash"
[[ -x "$r/git-merge-drivers/ve-special-ours" ]] && ok "plain: drivers executable" || bad "plain: drivers not executable"

r=$(mkrepo withlocal) || exit 1
printf 'git config imd.localtest yes\n' >"$r/install-merge-drivers.local"
mkdir -p "$r/sub"
(cd "$r/sub" && bash ../orch/install-merge-drivers.sh) >"$T/local.out" 2>&1; rc=$?
[[ $rc -eq 0 && "$(cfg "$r" imd.localtest)" == yes ]] && ok "local: .local run (from subdir), key set" || bad "local: rc=$rc $(cat "$T/local.out")"

r=$(mkrepo badlocal) || exit 1
printf 'exit 1\n' >"$r/install-merge-drivers.local"
(cd "$r" && bash ./orch/install-merge-drivers.sh) >"$T/bad.out" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q "install-merge-drivers.local failed" "$T/bad.out" && ok "bad local: non-zero exit with message" || bad "bad local: rc=$rc $(cat "$T/bad.out")"

r=$(mkrepo missing) || exit 1
rm "$r/git-merge-drivers/ve-special-refuse"
(cd "$r" && bash ./orch/install-merge-drivers.sh) >"$T/miss.out" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q ve-special-refuse "$T/miss.out" && ok "missing driver: fails, names file" || bad "missing driver: rc=$rc $(cat "$T/miss.out")"

mkdir -p "$T/nogit/orch"; cp "$canon/orch/install-merge-drivers.sh" "$T/nogit/orch/"
(cd "$T/nogit" && bash ./orch/install-merge-drivers.sh) >"$T/nogit.out" 2>&1; rc=$?
[[ $rc -ne 0 ]] && grep -q "not inside a git worktree" "$T/nogit.out" && ok "outside git: clear error" || bad "outside git: rc=$rc $(cat "$T/nogit.out")"

r="$T/plain"
(cd "$r" && bash ./orch/install-merge-drivers.sh -h) >"$T/h.out" 2>&1; rc=$?
[[ $rc -eq 0 ]] && head -1 "$T/h.out" | grep -q '^usage: ./orch/install-merge-drivers.sh' && ok "-h: usage, exit 0" || bad "-h: rc=$rc"
(cd "$r" && bash ./orch/install-merge-drivers.sh --bogus) >"$T/u.out" 2>&1; rc=$?
[[ $rc -eq 2 ]] && grep -q 'unrecognized option: --bogus' "$T/u.out" && ok "unknown option: exit 2" || bad "unknown option: rc=$rc"

echo "passed $pass, failed $fail"
[[ $fail -eq 0 ]]
