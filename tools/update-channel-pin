#!/usr/bin/env bash
# update-channel-pin: bring THIS tree's agent-coordination-tickets pin up to the one committed
# in orchestration-example (canon) HEAD, and commit it. Same content and commit message as
# ./deploy-orchestration --apply ("rules: sync from orchestration-example@<sha>"), but for one
# tree, so it can be run when that tree's agents are idle.
#
#   cd <project root or worktree> && ~/git/orchestration-example/tools/update-channel-pin
#
# Copies the three pinned paths from canon's committed blobs (never its working tree):
#   third_party/agent-coordination-tickets/{libpin.toml,SOURCE.md,artifact/channel}
# It only puts the files in place and commits them; it never runs the channel tools.
# Refuses: not a tree root with the pin; staged changes; pinned paths with local edits
# (files already identical to canon's, e.g. from an interrupted run, are fine); a known
# blocker (a tracked file still relying on behaviour the new pin removed). Verifies the
# artifact sha256, then commits only the pinned paths. Never pushes. A running channel-arm
# keeps the old binary until it is restarted (the file is replaced by rename).
set -euo pipefail
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "Usage: ./tools/update-channel-pin"
  echo "Bring this tree's agent-coordination-tickets pin up to orchestration-example HEAD. No arguments."
  exit 0
fi
die() { echo "update-channel-pin: $*" >&2; exit 1; }

canon="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lib=third_party/agent-coordination-tickets
paths=("$lib/libpin.toml" "$lib/SOURCE.md" "$lib/artifact/channel")

root="$(git rev-parse --show-toplevel)" || die "not inside a git tree"
[[ "$(pwd -P)" == "$(cd "$root" && pwd -P)" ]] || die "run it from the tree root ($root), not $(pwd)"
[[ "$(cd "$root" && pwd -P)" != "$(cd "$canon" && pwd -P)" ]] || die "this is canon itself; bump the pin there with third_party/fetch-deps upgrade"
[[ -f "$root/$lib/libpin.toml" ]] || die "$root has no $lib/libpin.toml (not an orchestration project tree)"

csha="$(git -C "$canon" rev-parse --short HEAD)"
for p in "${paths[@]}"; do
  git -C "$canon" cat-file -e "HEAD:$p" || die "canon $canon HEAD has no $p"
done
[[ -z "$(git -C "$canon" status --porcelain -- "${paths[@]}")" ]] || die "canon has uncommitted changes in the pinned paths; commit them first"

git diff --cached --quiet || die "the index has staged changes; commit or unstage them first"
# artifact/ entries other than the pinned binary must be clean
other="$(git status --porcelain -- "$lib/artifact" | grep -v " $lib/artifact/channel\$" || [[ $? -eq 1 ]])"
[[ -z "$other" ]] || die "$lib/artifact has other uncommitted changes:
$other"
bad=""
for p in "${paths[@]}"; do
  if [[ -n "$(git status --porcelain -- "$p")" && "$(git hash-object "$p")" != "$(git -C "$canon" rev-parse "HEAD:$p")" ]]; then
    bad+="$p"$'\n'
  fi
done
[[ -z "$bad" ]] || die "pinned paths have local edits (not canon's version):
$bad"

same=1
for p in "${paths[@]}"; do
  [[ "$(git -C "$canon" rev-parse "HEAD:$p")" == "$(git rev-parse "HEAD:$p")" ]] || same=0
done
if [[ "$same" -eq 1 ]]; then
  echo "update-channel-pin: $root already has canon's pin ($(sed -n 's/^git_describe = //p' "$lib/libpin.toml")); nothing to do"
  exit 0
fi

# Known blockers: tracked files that still rely on behaviour the new pin removed.
blk="$(git grep -nIE 'CHANNEL_SEND_WAIT|CONSUMED|outcome/|QUEUED|DEST took it|event=outcome|channel-send[^|]*--timeout' \
  -- ':!third_party/agent-coordination-tickets/src' ':!ENGINEERING_LOG.md' || [[ $? -eq 1 ]])"
[[ -z "$blk" ]] || die "these tracked files rely on removed channel behaviour (CHANNEL_SEND_WAIT is now an error; no outcome/, CONSUMED, QUEUED or send --timeout); fix them first:
$blk"

want="$(git -C "$canon" show "HEAD:$lib/libpin.toml" | sed -n 's/^sha256 = "\(.*\)"$/\1/p')"
[[ -n "$want" ]] || die "no artifact sha256 in canon's libpin.toml"
[[ "$(git -C "$canon" cat-file blob "HEAD:$lib/artifact/channel" | sha256sum | cut -d' ' -f1)" == "$want" ]] || die "canon's artifact/channel does not match its libpin.toml sha256"

# Install by rename (a running channel-arm keeps its old inode), then commit only the pin.
for p in "$lib/libpin.toml" "$lib/SOURCE.md"; do
  git -C "$canon" cat-file blob "HEAD:$p" > "$p.update-channel-pin.tmp"
  chmod --reference="$p" "$p.update-channel-pin.tmp"
  mv -f "$p.update-channel-pin.tmp" "$p"
done
git -C "$canon" cat-file blob "HEAD:$lib/artifact/channel" > "$lib/artifact/channel.update-channel-pin.tmp"
chmod 0775 "$lib/artifact/channel.update-channel-pin.tmp"
mv -f "$lib/artifact/channel.update-channel-pin.tmp" "$lib/artifact/channel"
[[ "$(sha256sum "$lib/artifact/channel" | cut -d' ' -f1)" == "$want" ]] || die "installed $lib/artifact/channel has the wrong sha256"

git commit -q --only -m "rules: sync from orchestration-example@$csha" -- "${paths[@]}"
echo "update-channel-pin: committed $(git log -1 --format='%h %s') in $root"
echo "  pin now $(sed -n 's/^git_describe = //p' "$lib/libpin.toml"); nothing pushed"
arms="$(pgrep -af "^$root/$lib/artifact/channel-arm " || [[ $? -eq 1 ]])"
if [[ -n "$arms" ]]; then
  echo "  these watches still run the old binary; each agent picks up the new one when it re-runs /channel:"
  echo "$arms" | sed 's/^/    /'
fi
